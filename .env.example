# Base de datos. Usa una sola de estas variantes:
# - SQLite local: DATABASE_PROVIDER=sqlite + DATABASE_URL=file:./dev.db
# - PostgreSQL: DATABASE_PROVIDER=postgresql + DATABASE_URL=postgresql://...
# - MariaDB: DATABASE_PROVIDER=mariadb + DATABASE_URL=mariadb://...
# - D1: DATABASE_PROVIDER=d1; DATABASE_URL no se usa.
DATABASE_URL="file:./dev.db"

# Fuente y proveedor de persistencia
CONTENT_SOURCE="dataset"
DATABASE_PROVIDER="sqlite"

# Adaptadores que usa la UI y las Server Actions.
# `rest` usa Better Auth y los Route Handlers reales; `mock` solo sirve para
# demos deterministas y no persiste usuarios en dev.db.
NEXT_PUBLIC_DATA_SOURCE="rest"

# Solo se usan cuando DATABASE_PROVIDER="d1".
# Cloudflare Worker: D1_TRANSPORT="binding" y binding DB en Wrangler.
# Vercel/Node: D1_TRANSPORT="http" con URL y token del Worker proxy.
# No pongas el token del proxy en el cliente ni lo comitees.
D1_TRANSPORT="binding"
D1_HTTP_URL=""
D1_HTTP_TOKEN=""

# Políticas operativas ajustables por despliegue (segundos, milisegundos o
# peticiones según el nombre). No cambian las reglas del dominio.
AUTH_SESSION_EXPIRES_IN_SECONDS="604800"
AUTH_SESSION_UPDATE_AGE_SECONDS="86400"
AUTH_COOKIE_CACHE_MAX_AGE_SECONDS="300"
ATTEMPT_RATE_LIMIT_WINDOW_MS="60000"
ATTEMPT_RATE_LIMIT_MAX="30"
AUTH_RATE_LIMIT_WINDOW_MS="60000"
AUTH_RATE_LIMIT_MAX="10"

# Reintentos adicionales de transacciones Prisma ante P2034 (serialización o deadlock).
# 0 desactiva los reintentos; SQLite normalmente no necesita más de ese valor.
PRISMA_TRANSACTION_RETRY_MAX="2"
PUBLIC_PAGE_DEFAULT_LIMIT="25"
PUBLIC_PAGE_MAX_LIMIT="100"
HTTP_MAX_REQUEST_BODY_BYTES="1048576"
HTTP_MAX_RESPONSE_BODY_BYTES="1048576"

# Mejor Auth
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
