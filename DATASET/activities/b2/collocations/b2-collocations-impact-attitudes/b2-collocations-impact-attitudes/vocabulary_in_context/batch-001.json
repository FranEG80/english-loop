{
  "schemaVersion":"1.0.0","batchId":"b2-collocations-impact-attitudes-vocabulary-in-context-001","level":"B2","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","lessonId":"b2-collocations-impact-attitudes","activityType":"vocabulary_in_context","activities":[
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-001","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":2,"instructions":"Choose the collocation that completes the context.","passage":"A local campaign explains how to reduce food waste. It wants to ___ awareness of the issue.","prompt":"Which collocation completes context 001?","options":[{"id":"a","text":"raise awareness"},{"id":"b","text":"make awareness"},{"id":"c","text":"do awareness"},{"id":"d","text":"put awareness"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","awareness"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The natural phrase is «raise awareness»."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-002","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":2,"instructions":"Choose the collocation that completes the context.","passage":"The new timetable changed attendance at evening classes. It had an ___ attendance.","prompt":"Which collocation completes context 002?","options":[{"id":"a","text":"impact on"},{"id":"b","text":"impact at"},{"id":"c","text":"impact for"},{"id":"d","text":"impact to"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","impact"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The noun «impact» normally takes «on» before its object."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-003","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":2,"instructions":"Choose the collocation that completes the context.","passage":"A leaking tank could harm birds and fish. The tank may ___ a threat to wildlife.","prompt":"Which collocation completes context 003?","options":[{"id":"a","text":"pose a threat"},{"id":"b","text":"make a threat"},{"id":"c","text":"do a threat"},{"id":"d","text":"take a threat"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","threat"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"We say «pose a threat to» a person, place or group."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-004","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":2,"instructions":"Choose the collocation that completes the context.","passage":"Several volunteers helped design the project. They ___ a role in its success.","prompt":"Which collocation completes context 004?","options":[{"id":"a","text":"played a role"},{"id":"b","text":"did a role"},{"id":"c","text":"made a role"},{"id":"d","text":"put a role"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","role"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The phrase «play a role in» connects a contribution with a result."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-005","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":2,"instructions":"Choose the collocation that completes the context.","passage":"The river is polluted, so the council needs an immediate response. It must ___ action.","prompt":"Which collocation completes context 005?","options":[{"id":"a","text":"take action"},{"id":"b","text":"make action"},{"id":"c","text":"do action"},{"id":"d","text":"put action"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","action"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The standard response phrase is «take action»."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-006","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":3,"instructions":"Choose the collocation that completes the context.","passage":"Parents worry about the safety of the crossing. They are ___ concerned.","prompt":"Which collocation completes context 006?","options":[{"id":"a","text":"deeply concerned"},{"id":"b","text":"deep concerned"},{"id":"c","text":"strong concerned"},{"id":"d","text":"firm concerned"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","concern"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Deeply concerned» uses the correct adverb-adjective combination."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-007","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":3,"instructions":"Choose the collocation that completes the context.","passage":"The reviewer finds several weaknesses in the proposal. She is ___ critical.","prompt":"Which collocation completes context 007?","options":[{"id":"a","text":"highly critical"},{"id":"b","text":"deeply critical"},{"id":"c","text":"firm critical"},{"id":"d","text":"strong critical"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","criticism"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The natural intensifier for «critical» here is «highly»."},
    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-008","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":3,"instructions":"Choose the collocation that completes the context.","passage":"The adviser thinks the plan is necessary. She would ___ an earlier start.","prompt":"Which collocation completes context 008?","options":[{"id":"a","text":"strongly recommend"},{"id":"b","text":"deeply recommend"},{"id":"c","text":"firm recommend"},{"id":"d","text":"high recommend"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","recommendation"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The standard phrase is «strongly recommend»."},
