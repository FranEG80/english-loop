    {"schemaVersion":"1.0.0","id":"b2-collocations-impact-attitudes-vc-017","status":"published","autoGradable":true,"level":"B2","type":"vocabulary_in_context","category":"collocations","topic":"b2-collocations-impact-attitudes","subtopic":"b2-collocations-impact-attitudes","taxonomyNodeIds":["b2-collocations-impact-attitudes"],"difficulty":4,"instructions":"Choose the collocation that completes the context.","passage":"The organisation approves the plan and wants it adopted. It strongly ___.","prompt":"Which collocation completes context 017?","options":[{"id":"a","text":"supports it"},{"id":"b","text":"opposes it"},{"id":"c","text":"concerns it"},{"id":"d","text":"threatens it"}],"lessonIds":["b2-collocations-impact-attitudes"],"tags":["b2","collocation","support"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Strongly supports» expresses emphatic approval."},
