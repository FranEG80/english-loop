      ],
      "difficulty": 4,
      "instructions": "Ayuda a la rana a cruzar el río eligiendo el nenúfar correcto en cada salto.",
      "prompt": "Partida de 8 rondas para repasar el tema jugando.",
      "game": "frog_leap",
      "rounds": [
        {
          "id": "r1",
          "prompt": "Which option means “The team needs more reliable data”?",
          "options": [
            {
              "id": "a",
              "text": "What the team needs is more reliable data."
            },
            {
              "id": "d",
              "text": "What is more reliable data the team needs."
            },
            {
              "id": "c",
              "text": "What the team need are more reliable data."
            }
          ],
          "explanation": "The what-clause is not a direct question."
        },
        {
          "id": "r2",
          "prompt": "Which sentence places the location at the front without changing the main order?",
          "options": [
            {
              "id": "d",
              "text": "At the routes, the old station met."
            },
            {
              "id": "c",
              "text": "The routes at met the old station."
            },
            {
              "id": "a",
              "text": "At the old station, the routes met."
            }
          ],
          "explanation": "A fronted place phrase is followed by normal subject-verb order."
        },
        {
          "id": "r3",
          "prompt": "What the committee needs ___ a clearer timetable.",
          "options": [
            {
              "id": "a",
              "text": "is"
            },
            {
              "id": "d",
              "text": "have"
            },
            {
              "id": "b",
              "text": "are"
            }
          ],
          "explanation": "The standard pattern uses singular is."
        },
        {
          "id": "r4",
          "prompt": "It was ___ Bristol that the study began.",
          "options": [
            {
              "id": "a",
              "text": "in"
            },
            {
              "id": "b",
              "text": "at"
            },
            {
              "id": "d",
              "text": "to"
            }
          ],
          "explanation": "In Bristol is the location phrase."
        },
        {
          "id": "r5",
          "prompt": "Which option emphasises the time of the decision?",
          "options": [
            {
              "id": "c",
              "text": "What after lunch they decided was the decision."
            },
            {
              "id": "a",
              "text": "It was after lunch that they made the decision."
            },
            {
              "id": "d",
              "text": "After lunch was it that they made the decision."
            }
          ],
          "explanation": "It-cleft focuses the time phrase and uses that."
        },
        {
          "id": "r6",
          "prompt": "Which option correctly combines a what-cleft and a singular focus?",
          "options": [
            {
              "id": "c",
              "text": "What did surprise everyone was the final cost."
            },
            {
              "id": "d",
              "text": "What surprised everyone the final cost was."
            },
            {
              "id": "a",
              "text": "What surprised everyone was the final cost."
            }
          ],
          "explanation": "Was completes the standard what-cleft with the singular focus."
        },
        {
          "id": "r7",
          "prompt": "What surprised everyone ___ the final cost.",
          "options": [
            {
              "id": "c",
              "text": "did"
            },
            {
              "id": "b",
              "text": "were"
            },
            {
              "id": "a",
              "text": "was"
            }
          ],
          "explanation": "The past context calls for was."
        },
        {
          "id": "r8",
          "prompt": "It was the sudden change in funding ___ surprised the panel.",
          "options": [
            {
              "id": "b",
              "text": "who"
            },
            {
              "id": "a",
              "text": "that"
            },
            {
              "id": "c",
              "text": "where"
            }
          ],
          "explanation": "That refers to the focused thing and introduces the clause."
        }
