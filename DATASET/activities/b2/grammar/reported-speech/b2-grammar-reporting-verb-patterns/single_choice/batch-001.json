  "activities": [
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-001","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":2,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"At the review meeting, the engineer ___ altering the safety figures.","options":[{"id":"a","text":"admitted"},{"id":"b","text":"suggested"},{"id":"c","text":"warned"},{"id":"d","text":"encouraged"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","admit","gerund"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Admit takes a gerund: admitted altering."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-002","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":2,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The spokesperson ___ denying the allegation in every interview.","options":[{"id":"a","text":"continued"},{"id":"b","text":"apologised"},{"id":"c","text":"persuaded"},{"id":"d","text":"accused"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","gerund","reporting-pattern"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Continue is followed by an -ing form: continued denying."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-003","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":2,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"Ravi ___ copying the design during the hearing.","options":[{"id":"a","text":"denied"},{"id":"b","text":"refused"},{"id":"c","text":"offered"},{"id":"d","text":"urged"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","deny","gerund"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Deny is followed by a gerund, not an infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-004","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":2,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The director apologised ___ the launch date.","options":[{"id":"a","text":"to delay"},{"id":"b","text":"for delaying"},{"id":"c","text":"delaying to"},{"id":"d","text":"for delay"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","apologise","preposition"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Apologise takes for plus a gerund when explaining the cause."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-005","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":2,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The auditor insisted ___ seeing the original receipts.","options":[{"id":"a","text":"to"},{"id":"b","text":"on"},{"id":"c","text":"for"},{"id":"d","text":"at"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","insist","preposition"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Insist is followed by on plus a gerund."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-006","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The tenants objected ___ paying the extra maintenance charge.","options":[{"id":"a","text":"to"},{"id":"b","text":"on"},{"id":"c","text":"for"},{"id":"d","text":"at"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","object","preposition"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Object to is followed by a noun or gerund."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-007","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The report accused the supplier ___ falsifying delivery records.","options":[{"id":"a","text":"of"},{"id":"b","text":"for"},{"id":"c","text":"to"},{"id":"d","text":"with"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","accuse","object-pattern"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Accuse someone of plus a gerund identifies the alleged action."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-008","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The project lead blamed the delay ___ the planning department.","options":[{"id":"a","text":"with"},{"id":"b","text":"on"},{"id":"c","text":"for"},{"id":"d","text":"to"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","blame","object-pattern"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Blame something on someone or something."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-009","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The ranger warned visitors ___ feed the wild birds.","options":[{"id":"a","text":"not to"},{"id":"b","text":"not feeding"},{"id":"c","text":"to not feeding"},{"id":"d","text":"against to"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","warn","object-infinitive"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Warn someone not to do something uses an object and a not to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-010","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The nurse reminded the patient ___ the tablets with food.","options":[{"id":"a","text":"taking"},{"id":"b","text":"to take"},{"id":"c","text":"of take"},{"id":"d","text":"take"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","remind","object-infinitive"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Remind someone to do something takes an object and a to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-011","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The mentor encouraged the interns ___ questions about the method.","options":[{"id":"a","text":"asking"},{"id":"b","text":"to ask"},{"id":"c","text":"ask to"},{"id":"d","text":"of asking"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","encourage","object-infinitive"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Encourage someone to do something uses object plus to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-012","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":3,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The mediator persuaded both sides ___ the timetable.","options":[{"id":"a","text":"revising"},{"id":"b","text":"to revise"},{"id":"c","text":"revise to"},{"id":"d","text":"of revising"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","persuade","object-infinitive"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Persuade someone to do something takes object plus to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-013","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The union urged the council ___ before winter.","options":[{"id":"a","text":"acting"},{"id":"b","text":"to act"},{"id":"c","text":"act to"},{"id":"d","text":"on acting"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","urge","object-infinitive"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Urge someone to do something is the standard pattern."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-014","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The travel editor recommended ___ the night train.","options":[{"id":"a","text":"to take"},{"id":"b","text":"taking"},{"id":"c","text":"the travellers take"},{"id":"d","text":"take to"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","recommend","gerund"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Recommend can be followed directly by a gerund."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-015","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The architect suggested ___ a covered walkway.","options":[{"id":"a","text":"to build"},{"id":"b","text":"building"},{"id":"c","text":"the council to building"},{"id":"d","text":"build to"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","suggest","gerund"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Suggest is followed by a gerund or a that-clause, not a direct to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-016","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The committee proposed ___ a shuttle for residents.","options":[{"id":"a","text":"running"},{"id":"b","text":"to run"},{"id":"c","text":"the organisers to running"},{"id":"d","text":"run to"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","propose","gerund"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Propose commonly takes a gerund when introducing an idea."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-017","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The contractor agreed ___ the damaged tiles.","options":[{"id":"a","text":"replacing"},{"id":"b","text":"to replace"},{"id":"c","text":"replace to"},{"id":"d","text":"of replacing"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","agree","to-infinitive"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Agree is followed by a to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-018","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The publisher refused ___ the unverified claim.","options":[{"id":"a","text":"repeating"},{"id":"b","text":"to repeat"},{"id":"c","text":"repeat to"},{"id":"d","text":"of repeating"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","refuse","to-infinitive"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Refuse takes a to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-019","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The scientist promised ___ the full dataset.","options":[{"id":"a","text":"releasing"},{"id":"b","text":"to release"},{"id":"c","text":"release to"},{"id":"d","text":"of releasing"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","promise","to-infinitive"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Promise is followed by a to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-020","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":4,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The landlord threatened ___ the agreement if rent remained unpaid.","options":[{"id":"a","text":"terminating"},{"id":"b","text":"to terminate"},{"id":"c","text":"terminate to"},{"id":"d","text":"of terminating"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","threaten","to-infinitive"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Threaten takes a to-infinitive for a possible future action."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-021","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":5,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The volunteer offered ___ the archive visitors around.","options":[{"id":"a","text":"showing"},{"id":"b","text":"to show"},{"id":"c","text":"show to"},{"id":"d","text":"of showing"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","offer","to-infinitive"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Offer is followed by a to-infinitive when making a proposal."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-022","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":5,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The chairperson advised delegates ___ personal data in the minutes.","options":[{"id":"a","text":"not to include"},{"id":"b","text":"not including"},{"id":"c","text":"to not including"},{"id":"d","text":"against include"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","advise","object-infinitive"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Advise someone not to do something uses object plus not to-infinitive."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-023","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":5,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The witness claimed ___ the warning clearly.","options":[{"id":"a","text":"understanding"},{"id":"b","text":"to understand"},{"id":"c","text":"understand to"},{"id":"d","text":"of understanding"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","claim","to-infinitive"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Claim is followed by a to-infinitive in this reporting pattern."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-024","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":5,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The campaigner admitted ___ the deadline by two days.","options":[{"id":"a","text":"missing"},{"id":"b","text":"to miss"},{"id":"c","text":"miss to"},{"id":"d","text":"of miss"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","admit","gerund"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Admit takes a gerund to report responsibility for an action."},
    {"schemaVersion":"1.0.0","id":"b2-reporting-verb-patterns-sc-025","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"reported-speech","subtopic":"reporting-verb-patterns","taxonomyNodeIds":["reporting-verb-patterns"],"difficulty":5,"instructions":"Choose the reporting-verb pattern that completes the sentence.","prompt":"The analyst claimed ___ the discrepancy earlier.","options":[{"id":"a","text":"noticing"},{"id":"b","text":"to have noticed"},{"id":"c","text":"notice to"},{"id":"d","text":"of noticing"}],"lessonIds":["b2-grammar-reporting-verb-patterns"],"tags":["b2","claim","perfect-infinitive"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"A perfect infinitive places the noticing before the claim."}
