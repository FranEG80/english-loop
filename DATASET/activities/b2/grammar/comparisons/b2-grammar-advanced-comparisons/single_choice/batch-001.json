  "activityType":"single_choice",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-001","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"The ___ we practise, the more confident we become.","options":[{"id":"a","text":"more"},{"id":"b","text":"most"},{"id":"c","text":"much"},{"id":"d","text":"many"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","comparative"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The more...the more links two proportional changes."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-002","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"The less waste we produce, the ___ the disposal bill becomes.","options":[{"id":"a","text":"low"},{"id":"b","text":"lower"},{"id":"c","text":"lowest"},{"id":"d","text":"more low"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","comparative"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The second part needs a comparative adjective: the lower."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-003","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"This tablet is as durable ___ the previous version.","options":[{"id":"a","text":"than"},{"id":"b","text":"like"},{"id":"c","text":"as"},{"id":"d","text":"so"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","equality","as-as"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"Equality uses as + adjective + as."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-004","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"The replacement is not ___ noisy as the old motor.","options":[{"id":"a","text":"than"},{"id":"b","text":"so"},{"id":"c","text":"like"},{"id":"d","text":"more"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","inequality","as-as"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Not so...as is a standard negative equality pattern."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-005","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"The new battery is nowhere near ___ heavy as the old one.","options":[{"id":"a","text":"than"},{"id":"b","text":"so"},{"id":"c","text":"as"},{"id":"d","text":"like"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","degree","as-as"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"Nowhere near is followed by as...as."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-006","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"The sculpture looks ___ a folded sail.","options":[{"id":"a","text":"as"},{"id":"b","text":"like"},{"id":"c","text":"than"},{"id":"d","text":"so"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","like","similarity"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Like is followed by a noun phrase."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-007","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":2,"instructions":"Choose the correct comparison.","prompt":"___ the project coordinator, Omar signs the final plan.","options":[{"id":"a","text":"Like"},{"id":"b","text":"As"},{"id":"c","text":"Than"},{"id":"d","text":"So"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as","role"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"As introduces a role or function."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-008","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"She speaks ___ she had attended the meeting.","options":[{"id":"a","text":"like"},{"id":"b","text":"as"},{"id":"c","text":"as if"},{"id":"d","text":"than"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as-if","hypothesis"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"As if introduces an appearance or hypothetical comparison."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-009","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"He behaves ___ though he owned the whole building.","options":[{"id":"a","text":"like"},{"id":"b","text":"as"},{"id":"c","text":"so"},{"id":"d","text":"than"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as-though","hypothesis"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The fixed connector is as though."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-010","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"There are ___ complaints this month than last month.","options":[{"id":"a","text":"less"},{"id":"b","text":"fewer"},{"id":"c","text":"little"},{"id":"d","text":"few"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","fewer","countable"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Complaints is a countable plural noun, so use fewer."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-011","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"There is ___ traffic after the new tram line opened.","options":[{"id":"a","text":"fewer"},{"id":"b","text":"less"},{"id":"c","text":"few"},{"id":"d","text":"many"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","less","uncountable"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Traffic is uncountable, so use less."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-012","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"The more carefully we plan, the ___ delays we have.","options":[{"id":"a","text":"few"},{"id":"b","text":"fewer"},{"id":"c","text":"less"},{"id":"d","text":"little"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","fewer"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Delays is a countable plural noun: fewer delays."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-013","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"The ___ data we collect, the more reliable the forecast becomes.","options":[{"id":"a","text":"many"},{"id":"b","text":"more"},{"id":"c","text":"most"},{"id":"d","text":"much"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","uncountable"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The more data...the more reliable is the proportional pattern."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-014","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":3,"instructions":"Choose the correct comparison.","prompt":"The coastal road is almost ___ scenic as the mountain route.","options":[{"id":"a","text":"so"},{"id":"b","text":"as"},{"id":"c","text":"than"},{"id":"d","text":"like"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","almost","as-as"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Almost as...as expresses near equality."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-015","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":4,"instructions":"Choose the correct comparison.","prompt":"Choose the formal sentence meaning that she works in the role of an editor.","options":[{"id":"a","text":"She works like an editor."},{"id":"b","text":"She works as an editor."},{"id":"c","text":"She works as if an editor."},{"id":"d","text":"She works than an editor."}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as","role"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"As plus a noun identifies a role or function."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-016","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":4,"instructions":"Choose the correct comparison.","prompt":"Choose the sentence comparing her appearance with her mother’s.","options":[{"id":"a","text":"She looks as her mother."},{"id":"b","text":"She looks like her mother."},{"id":"c","text":"She looks as if her mother."},{"id":"d","text":"She looks than her mother."}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","like","similarity"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Like is followed by the noun phrase her mother."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-017","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":4,"instructions":"Choose the correct comparison.","prompt":"The software is nowhere near ___ complex as the old system.","options":[{"id":"a","text":"than"},{"id":"b","text":"as"},{"id":"c","text":"like"},{"id":"d","text":"so"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","degree","as-as"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Nowhere near as...as marks a large difference."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-018","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":4,"instructions":"Choose the correct comparison.","prompt":"The more the team communicates, the ___ misunderstandings arise.","options":[{"id":"a","text":"fewer"},{"id":"b","text":"few"},{"id":"c","text":"less"},{"id":"d","text":"little"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","fewer"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Misunderstandings is countable plural, so use fewer."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-019","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":4,"instructions":"Choose the correct comparison.","prompt":"The less equipment we carry, the ___ mobile the team is.","options":[{"id":"a","text":"most"},{"id":"b","text":"more"},{"id":"c","text":"many"},{"id":"d","text":"much"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","comparative"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The less...the more links two related changes."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-020","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":4,"instructions":"Choose the correct comparison.","prompt":"He answered as ___ he had memorised the entire report.","options":[{"id":"a","text":"like"},{"id":"b","text":"if"},{"id":"c","text":"than"},{"id":"d","text":"so"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as-if","hypothesis"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"As if is the connector before the clause."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-021","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":5,"instructions":"Choose the correct comparison.","prompt":"Which sentence uses as to introduce a clause rather than a role?","options":[{"id":"a","text":"As the coordinator, she checks the rota."},{"id":"b","text":"As we discussed, the figures need checking."},{"id":"c","text":"She looks like a coordinator."},{"id":"d","text":"She is as calm as the coordinator."}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as","clause"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"As we discussed introduces a full clause."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-022","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":5,"instructions":"Choose the correct comparison.","prompt":"The survey was not ___ detailed as the interview study.","options":[{"id":"a","text":"like"},{"id":"b","text":"as"},{"id":"c","text":"than"},{"id":"d","text":"so much"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","inequality","as-as"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Not as...as compares degree."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-023","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":5,"instructions":"Choose the correct comparison.","prompt":"Which option correctly describes a proportional fall in cost?","options":[{"id":"a","text":"The less we waste, the lower the cost."},{"id":"b","text":"The less we waste, lower the cost."},{"id":"c","text":"Less we waste, the lower cost."},{"id":"d","text":"The less we waste, the lowest the cost."}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","correlative","structure"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Both clauses require the and a comparative form."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-024","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":5,"instructions":"Choose the correct comparison.","prompt":"He talks as though he ___ the final decision-maker.","options":[{"id":"a","text":"is"},{"id":"b","text":"were"},{"id":"c","text":"be"},{"id":"d","text":"has"}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as-though","distance"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Were can mark hypothetical distance after as though."},
    {"schemaVersion":"1.0.0","id":"b2-advanced-comparisons-sc-025","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"grammar","topic":"comparisons","subtopic":"advanced-comparisons","taxonomyNodeIds":["advanced-comparisons"],"difficulty":5,"instructions":"Choose the correct comparison.","prompt":"Which sentence is correct in formal written English?","options":[{"id":"a","text":"She works like the director advised."},{"id":"b","text":"She works as the director advised."},{"id":"c","text":"She works as a director advised."},{"id":"d","text":"She works than the director advised."}],"lessonIds":["b2-grammar-advanced-comparisons"],"tags":["b2","as","clause"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"As introduces the clause the director advised."}
  ]
}
