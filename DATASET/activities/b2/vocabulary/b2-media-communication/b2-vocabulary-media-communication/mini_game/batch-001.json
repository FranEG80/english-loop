          "prompt": "Which action is most responsible before sharing a surprising image?",
          "options": [
            {
              "id": "c",
              "text": "rewrite its date"
            },
            {
              "id": "d",
              "text": "increase its bias"
            },
            {
              "id": "a",
              "text": "verify its source"
            }
          ],
          "explanation": "Verifying the source can reveal whether an image is genuine and current."
        },
