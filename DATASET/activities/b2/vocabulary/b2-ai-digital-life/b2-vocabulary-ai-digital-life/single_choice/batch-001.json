{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-008","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":3,"instructions":"Choose the correct word.","prompt":"The company uses ___ to protect messages from unauthorised readers.","options":[{"id":"a","text":"encryption"},{"id":"b","text":"footprint"},{"id":"c","text":"bias"},{"id":"d","text":"interface"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","encryption"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Encryption protects information by transforming it into coded form."},
{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-009","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":3,"instructions":"Choose the correct term.","prompt":"The record of websites and services a person has used is a digital ___.","options":[{"id":"a","text":"footprint"},{"id":"b","text":"patch"},{"id":"c","text":"model"},{"id":"d","text":"breach"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","footprint"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A digital footprint is the trace left by online activity."},
{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-010","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":3,"instructions":"Choose the correct term.","prompt":"A security incident in which personal records are exposed is a data ___.","options":[{"id":"a","text":"breach"},{"id":"b","text":"update"},{"id":"c","text":"interface"},{"id":"d","text":"dataset"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","breach"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A data breach exposes information to people who should not access it."},
