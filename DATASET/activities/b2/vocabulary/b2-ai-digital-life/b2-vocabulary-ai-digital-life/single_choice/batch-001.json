{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-002","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":2,"instructions":"Choose the correct term.","prompt":"The examples used to train a model form a ___.","options":[{"id":"a","text":"dataset"},{"id":"b","text":"firewall"},{"id":"c","text":"shortcut"},{"id":"d","text":"screen"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","dataset"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A dataset is an organised collection of data."},
{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-003","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":2,"instructions":"Choose the correct word.","prompt":"The assistant can ___ speech into written notes.","options":[{"id":"a","text":"convert"},{"id":"b","text":"consent"},{"id":"c","text":"breach"},{"id":"d","text":"bias"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","speech"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Convert means change something from one form into another."},
