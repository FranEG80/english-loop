{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-005","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":2,"instructions":"Choose the correct term.","prompt":"A programme that answers customers' questions automatically is a ___.","options":[{"id":"a","text":"chatbot"},{"id":"b","text":"dataset"},{"id":"c","text":"patch"},{"id":"d","text":"consent"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","chatbot"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A chatbot communicates with users through automated conversation."},
{"schemaVersion":"1.0.0","id":"b2-ai-digital-life-sc-006","status":"published","autoGradable":true,"level":"B2","type":"single_choice","category":"vocabulary","topic":"b2-ai-digital-life","subtopic":"b2-ai-digital-life","taxonomyNodeIds":["b2-ai-digital-life"],"difficulty":2,"instructions":"Choose the correct word.","prompt":"The service asks for users' ___ before storing their location.","options":[{"id":"a","text":"consent"},{"id":"b","text":"bias"},{"id":"c","text":"interface"},{"id":"d","text":"shortcut"}],"lessonIds":["b2-vocabulary-ai-digital-life"],"tags":["b2","consent"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Consent is permission given before information is collected or used."},
