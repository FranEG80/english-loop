          "id": "r3",
          "prompt": "When [gap1] the exhibition open?",
          "options": [
            {
              "id": "d",
              "text": "has"
            },
            {
              "id": "b",
              "text": "does"
            },
            {
              "id": "a",
              "text": "did"
            }
          ],
          "explanation": "El pasado simple directo usa «did + forma base»."
        },
