              "id": "c",
              "text": "is"
            },
            {
              "id": "d",
              "text": "did"
            }
          ],
          "explanation": "El sujeto singular usa «does + forma base»."
        },
        {
          "id": "r8",
          "prompt": "Direct: “Who manages the community garden?”",
          "options": [
