      "taxonomyNodeIds": [
        "direct-indirect-questions"
      ],
      "difficulty": 4,
      "instructions": "Apila los fragmentos en orden para levantar la frase.",
      "prompt": "Partida de 8 rondas para repasar el tema jugando.",
      "game": "sentence_tower",
      "rounds": [
        {
          "id": "r1",
          "prompt": "[gap1] the nearest pharmacy?",
          "options": [
            {
              "id": "d",
              "text": "Where be"
            },
            {
              "id": "a",
              "text": "Where is"
            },
            {
              "id": "c",
              "text": "Where the"
            }
          ],
          "explanation": "Con «be» invertimos: «Where is ...?»."
        },
        {
          "id": "r2",
          "prompt": "Which sentence is punctuated correctly?",
          "options": [
            {
              "id": "c",
              "text": "Could you tell me where does the bus stop."
            },
            {
              "id": "d",
              "text": "I wonder, where the bus stops?"
            },
            {
              "id": "a",
              "text": "Could you tell me where the bus stops?"
            }
          ],
          "explanation": "La expresión principal es una pregunta y lleva signo; «I wonder» terminaría con punto."
        },
        {
          "id": "r3",
          "prompt": "[gap1] the delay?",
          "options": [
            {
              "id": "b",
              "text": "What did cause"
            },
            {
              "id": "c",
              "text": "What did caused"
            },
            {
              "id": "a",
              "text": "What caused"
            }
          ],
          "explanation": "«What» es sujeto y no necesita «did»."
        },
        {
          "id": "r4",
          "prompt": "Do you know what time the museum [gap1]?",
          "options": [
            {
              "id": "b",
              "text": "does close"
            },
            {
              "id": "d",
              "text": "is close"
            },
            {
              "id": "a",
              "text": "closes"
            }
          ],
          "explanation": "Desaparece «does» y el verbo concuerda: «the museum closes»."
        },
        {
          "id": "r5",
          "prompt": "Which version asks indirectly about the deposit without inversion?",
          "options": [
            {
              "id": "d",
              "text": "I'd like to know that the deposit is refundable or not?"
            },
            {
              "id": "a",
              "text": "I'd like to know whether or not the deposit is refundable."
            },
            {
              "id": "c",
              "text": "I'd like to know if or not is the deposit refundable."
            }
          ],
          "explanation": "«Whether or not» va seguido de orden afirmativo."
        },
        {
          "id": "r6",
          "prompt": "You want to ask politely about the duration of a closure.",
          "options": [
            {
              "id": "c",
              "text": "Could you tell me how long the road has been close?"
            },
            {
              "id": "b",
              "text": "Could you tell me how long has the road been closed?"
            },
            {
              "id": "a",
              "text": "Could you tell me how long the road has been closed?"
            }
          ],
          "explanation": "El contenido indirecto conserva «the road has been closed»."
        },
        {
          "id": "r7",
          "prompt": "You need to know whether an appointment is necessary and how long it takes.",
          "options": [
            {
              "id": "a",
              "text": "Could you tell me if I need an appointment and how long the process takes?"
            },
            {
              "id": "c",
              "text": "Could you tell me that I need an appointment and how long the process take?"
            },
            {
              "id": "b",
              "text": "Could you tell me do I need an appointment and how long does the process take?"
            }
          ],
          "explanation": "Ambas partes indirectas usan orden afirmativo; la cerrada lleva «if»."
        },
        {
          "id": "r8",
          "prompt": "Direct: “Have the replacement parts arrived?”",
          "options": [
            {
              "id": "b",
              "text": "I'd like to know whether have the replacement parts arrived."
