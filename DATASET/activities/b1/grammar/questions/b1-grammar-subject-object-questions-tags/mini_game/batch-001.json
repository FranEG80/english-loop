      ],
      "difficulty": 4,
      "instructions": "Ayuda a la rana a cruzar el río eligiendo el nenúfar correcto en cada salto.",
      "prompt": "Partida de 8 rondas para repasar el tema jugando.",
      "game": "frog_leap",
      "rounds": [
        {
          "id": "r1",
          "prompt": "There's a pharmacy nearby, ___?",
          "options": [
            {
              "id": "a",
              "text": "isn't there"
            },
            {
              "id": "b",
              "text": "isn't it"
            },
            {
              "id": "c",
              "text": "doesn't there"
            }
          ],
          "explanation": "La tag de «there is» conserva «there»."
        },
        {
          "id": "r2",
          "prompt": "There weren't any delays, ___?",
          "options": [
            {
              "id": "b",
              "text": "weren't there"
            },
            {
              "id": "d",
              "text": "did there"
            },
            {
              "id": "a",
              "text": "were there"
            }
          ],
          "explanation": "El enunciado negativo usa tag positiva y conserva «there»."
        },
        {
          "id": "r3",
          "prompt": "___ outside?",
          "options": [
            {
              "id": "a",
              "text": "Who is waiting"
            },
            {
              "id": "c",
              "text": "Who waiting is"
            },
            {
              "id": "b",
              "text": "Who does wait"
            }
          ],
          "explanation": "«Who» es sujeto y conserva «is waiting»."
        },
        {
          "id": "r4",
          "prompt": "Who ___ you call?",
          "options": [
            {
              "id": "a",
              "text": "did"
            },
            {
              "id": "c",
              "text": "has"
            },
            {
              "id": "b",
              "text": "was"
            }
          ],
          "explanation": "«You» es sujeto; la pregunta pasada de objeto usa «did»."
        },
        {
          "id": "r5",
          "prompt": "Let's take a break, ___?",
          "options": [
            {
              "id": "b",
              "text": "will we"
            },
            {
              "id": "a",
              "text": "shall we"
            },
            {
              "id": "c",
              "text": "don't we"
            }
          ],
          "explanation": "Con «Let's» usamos «shall we?»."
        },
        {
          "id": "r6",
          "prompt": "Who ___ the manager invited?",
          "options": [
            {
              "id": "b",
              "text": "did"
            },
            {
              "id": "c",
              "text": "does"
            },
            {
              "id": "a",
              "text": "has"
            }
          ],
          "explanation": "El present perfect de objeto usa «Who has + sujeto + participio?»."
        },
        {
          "id": "r7",
          "prompt": "The office is open, ___?",
          "options": [
            {
              "id": "b",
              "text": "doesn't it"
            },
            {
              "id": "a",
              "text": "isn't it"
            },
            {
              "id": "d",
              "text": "aren't they"
            }
          ],
          "explanation": "Repetimos «is», cambiamos polaridad y usamos «it»."
        },
        {
          "id": "r8",
          "prompt": "The facts are: Elena emailed Sam.",
          "options": [
            {
              "id": "a",
              "text": "Who emailed Sam? / Who did Elena email?"
            },
            {
              "id": "d",
              "text": "Who was emailed Sam? / Who did Elena emailed?"
            },
            {
              "id": "b",
              "text": "Who did email Sam? / Who Elena emailed?"
            }
          ],
          "explanation": "La primera pregunta busca al sujeto Elena; la segunda al objeto Sam."
        }
      ],
