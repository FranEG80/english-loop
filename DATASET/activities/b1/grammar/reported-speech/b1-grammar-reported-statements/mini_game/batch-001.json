    {
      "schemaVersion": "2.0.0",
      "id": "b1-grammar-reported-statements-mg-lane-runner-001",
      "status": "published",
      "autoGradable": true,
      "level": "B1",
      "type": "mini_game",
      "skillFocus": "mini_game",
      "category": "grammar",
      "topic": "reported-speech",
      "subtopic": "reported-statements",
      "taxonomyNodeIds": [
        "reported-statements"
      ],
      "difficulty": 3,
      "instructions": "Colócate en el carril de la respuesta correcta antes de cruzar cada puerta.",
      "prompt": "Partida de 8 rondas para repasar el tema jugando.",
      "game": "lane_runner",
      "rounds": [
        {
          "id": "r1",
          "prompt": "Nora told Amir, “I left your folder on my desk.”",
          "options": [
            {
              "id": "a",
              "text": "Nora told Amir that she had left his folder on her desk."
            },
            {
              "id": "d",
              "text": "Nora told to Amir that he had left her folder."
            },
            {
              "id": "c",
              "text": "Nora said Amir that she left her folder on his desk."
            }
          ],
          "explanation": "«I/my» se refieren a Nora y «your» a Amir."
        },
        {
          "id": "r2",
          "prompt": "Marta said, “I had already eaten, so I couldn't join the lunch.”",
          "options": [
            {
              "id": "d",
              "text": "Marta said me she had been eat, so she wouldn't joining."
            },
            {
              "id": "a",
              "text": "Marta said that she had already eaten, so she couldn't join the lunch."
            },
            {
              "id": "b",
              "text": "Marta said that she has already ate, so she can't joined the lunch."
            }
          ],
          "explanation": "Past perfect y «couldn't» no necesitan retroceder más; solo cambian los pronombres."
        },
        {
          "id": "r3",
          "prompt": "On Friday Leo said, “I will bring this sample here tomorrow.”",
          "options": [
            {
              "id": "a",
              "text": "Leo said that he would bring that sample there the next day."
            },
            {
              "id": "c",
              "text": "Leo told that he would brought those sample yesterday."
            },
            {
              "id": "b",
              "text": "Leo said that I will bring this sample here tomorrow."
            }
          ],
          "explanation": "Cambian «I», «will», «this», «here» y «tomorrow»."
        },
        {
          "id": "r4",
          "prompt": "After leaving the site, Ana reported “I keep these tools here” as: Ana said that she kept ___ tools ___.",
          "options": [
            {
              "id": "b",
              "text": "these / here"
            },
            {
              "id": "d",
              "text": "those / tomorrow"
            },
            {
              "id": "a",
              "text": "those / there"
            }
          ],
          "explanation": "Al cambiar lugar y perspectiva, «these» pasa a «those» y «here» a «there»."
        },
        {
          "id": "r5",
          "prompt": "Lena said, “I am tired.” Lena said that ___ was tired.",
          "options": [
            {
              "id": "d",
              "text": "they"
            },
            {
              "id": "c",
              "text": "you"
            },
            {
              "id": "a",
              "text": "she"
            }
          ],
          "explanation": "El «I» original se refiere a Lena y pasa a «she»."
        },
        {
          "id": "r6",
          "prompt": "Maya ___ that the office was closed.",
          "options": [
            {
              "id": "d",
              "text": "told to"
            },
            {
              "id": "c",
              "text": "said me"
            },
            {
              "id": "a",
              "text": "said"
            }
          ],
          "explanation": "Sin un objeto personal usamos «said that»."
        },
        {
          "id": "r7",
          "prompt": "“The parcel will arrive tomorrow,” Jo said. Later, we reported that it would arrive ___.",
          "options": [
            {
              "id": "c",
              "text": "today"
            },
            {
              "id": "b",
              "text": "yesterday"
            },
            {
              "id": "a",
              "text": "the next day"
            }
          ],
          "explanation": "«Tomorrow» cambia a «the next day»."
        },
        {
          "id": "r8",
          "prompt": "“I can repair the lock,” Ravi said. Ravi said that he ___ repair the lock.",
          "options": [
            {
              "id": "a",
              "text": "could"
            },
            {
              "id": "b",
              "text": "can"
            },
            {
              "id": "d",
              "text": "was can"
            }
          ],
          "explanation": "«Can» retrocede a «could»."
        }
      ],
