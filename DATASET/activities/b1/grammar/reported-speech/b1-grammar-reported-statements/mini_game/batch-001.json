      "taxonomyNodeIds": [
        "reported-statements"
      ],
      "difficulty": 3,
      "instructions": "Ayuda a la rana a cruzar el río eligiendo el nenúfar correcto en cada salto.",
      "prompt": "Partida de 8 rondas para repasar el tema jugando.",
      "game": "frog_leap",
      "rounds": [
        {
          "id": "r1",
          "prompt": "On Monday Sara said, “I will finish today.” On Wednesday we reported that Sara would finish ___.",
          "options": [
            {
              "id": "a",
              "text": "that day"
            },
            {
              "id": "d",
              "text": "now"
            },
            {
              "id": "c",
              "text": "tomorrow"
            }
          ],
          "explanation": "El «today» del lunes pasa a «that day»."
        },
        {
          "id": "r2",
          "prompt": "“I will call the supplier,” Eva said. Eva said that she ___ call the supplier.",
          "options": [
            {
              "id": "c",
              "text": "had"
            },
            {
              "id": "b",
              "text": "will"
            },
            {
              "id": "a",
              "text": "would"
            }
          ],
          "explanation": "«Will» retrocede a «would»."
        },
        {
          "id": "r3",
          "prompt": "Mina told Leo, “I can help you.” Mina told Leo that she could help ___.",
          "options": [
            {
              "id": "a",
              "text": "him"
            },
            {
              "id": "c",
              "text": "me"
            },
            {
              "id": "d",
              "text": "us"
            }
          ],
          "explanation": "El «you» original se refiere a Leo y pasa a «him»."
        },
        {
          "id": "r4",
          "prompt": "“I am waiting outside,” Nora said. Nora said that she ___ outside.",
          "options": [
            {
              "id": "b",
              "text": "is waiting"
            },
            {
              "id": "a",
              "text": "was waiting"
            },
            {
              "id": "d",
              "text": "had wait"
            }
          ],
          "explanation": "El presente continuo retrocede a pasado continuo."
        },
        {
          "id": "r5",
          "prompt": "“I work remotely,” Leo said. Leo said that he ___ remotely.",
          "options": [
            {
              "id": "a",
              "text": "worked"
            },
            {
              "id": "d",
              "text": "had work"
            },
            {
              "id": "b",
              "text": "works"
            }
          ],
          "explanation": "Con «said», el presente simple retrocede a pasado simple."
        },
        {
          "id": "r6",
          "prompt": "The teacher said, “Water freezes at 0°C.”",
          "options": [
            {
              "id": "b",
              "text": "The teacher told that water froze at 0°C."
            },
            {
              "id": "a",
              "text": "The teacher said that water freezes at 0°C."
            },
            {
              "id": "d",
              "text": "The teacher told us water will freeze at 0°C yesterday."
            }
          ],
          "explanation": "Un hecho general vigente puede mantener el presente."
        },
        {
          "id": "r7",
          "prompt": "“I must renew my permit,” Salma said. Salma said that she ___ renew her permit.",
          "options": [
            {
              "id": "d",
              "text": "had"
            },
            {
              "id": "a",
              "text": "had to"
            },
            {
              "id": "b",
              "text": "musted"
            }
          ],
          "explanation": "El «must» de obligación cambia normalmente a «had to»."
        },
        {
          "id": "r8",
          "prompt": "“I met her yesterday,” Ben said. Ben said that he had met her ___.",
          "options": [
            {
              "id": "a",
              "text": "the day before"
            },
            {
              "id": "c",
              "text": "today"
            },
            {
              "id": "b",
              "text": "tomorrow"
            }
          ],
          "explanation": "«Yesterday» cambia a «the day before»."
        }
      ],
