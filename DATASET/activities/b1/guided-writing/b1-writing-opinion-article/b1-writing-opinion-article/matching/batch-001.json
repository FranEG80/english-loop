    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-016","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":4,"instructions":"Match each linking phrase with its relationship.","prompt":"Match advanced connectors with their relationships.","pairs":[{"leftId":"a","left":"As a result","rightId":"x","right":"shows a consequence"},{"leftId":"b","left":"On the other hand","rightId":"y","right":"presents another side"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","connectors"],"estimatedSeconds":55,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"As a result points forward to an effect; On the other hand changes perspective."},
