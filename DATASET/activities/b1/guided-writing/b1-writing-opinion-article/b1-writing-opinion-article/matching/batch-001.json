    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-021","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":5,"instructions":"Match each thesis with the best paragraph focus.","prompt":"Match detailed theses with focused supporting paragraphs.","pairs":[{"leftId":"a","left":"Schools should teach finance","rightId":"x","right":"budgeting and safe spending"},{"leftId":"b","left":"Towns need safer crossings","rightId":"y","right":"visibility and pedestrian priority"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","focus"],"estimatedSeconds":60,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"A focused paragraph develops one part of the thesis rather than changing subject."},
