{
  "schemaVersion":"1.0.0","batchId":"b1-writing-opinion-article-matching-001","level":"B1","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","lessonId":"b1-writing-opinion-article","activityType":"matching",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-001","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":1,"instructions":"Match each phrase with its writing function.","prompt":"Match basic opinion-writing phrases with their functions.","pairs":[{"leftId":"a","left":"In my view","rightId":"x","right":"introduces an opinion"},{"leftId":"b","left":"For example","rightId":"y","right":"introduces evidence"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","matching"],"estimatedSeconds":40,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"In my view states a position; For example introduces a concrete detail."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-002","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":1,"instructions":"Match each section with its purpose.","prompt":"Match the opening parts of an opinion article.","pairs":[{"leftId":"a","left":"Title","rightId":"x","right":"names the main idea"},{"leftId":"b","left":"Conclusion","rightId":"y","right":"restates the position"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","structure"],"estimatedSeconds":40,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"A title names the focus; a conclusion returns to the position."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-003","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":1,"instructions":"Match each connector with its function.","prompt":"Match connectors used in a short opinion paragraph.","pairs":[{"leftId":"a","left":"because","rightId":"x","right":"gives a reason"},{"leftId":"b","left":"Overall","rightId":"y","right":"summarises the view"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","connectors"],"estimatedSeconds":40,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"Because explains why; Overall signals a final summary."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-004","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":1,"instructions":"Match each sentence part with its continuation.","prompt":"Match simple claims with suitable support.","pairs":[{"leftId":"a","left":"Parks are useful","rightId":"x","right":"because children can exercise there"},{"leftId":"b","left":"Local food matters","rightId":"y","right":"because it travels a shorter distance"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","support"],"estimatedSeconds":40,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"Each continuation gives a relevant reason for the claim."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-005","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":1,"instructions":"Match each ending with the action it recommends.","prompt":"Match short conclusions with their recommendations.","pairs":[{"leftId":"a","left":"The town should add cycle lanes","rightId":"x","right":"support safer cycling"},{"leftId":"b","left":"Schools should open clubs","rightId":"y","right":"give students more activities"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","recommendations"],"estimatedSeconds":40,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"Both matches connect a recommendation with its intended benefit."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-006","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":2,"instructions":"Match each phrase with its role.","prompt":"Match phrases that organise an opinion article.","pairs":[{"leftId":"a","left":"To begin with","rightId":"x","right":"starts a point"},{"leftId":"b","left":"For these reasons","rightId":"y","right":"introduces a conclusion"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","organisation"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"To begin with opens a point; For these reasons links the conclusion to support."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-007","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":2,"instructions":"Match each connector with its meaning.","prompt":"Match contrast and result connectors.","pairs":[{"leftId":"a","left":"However","rightId":"x","right":"introduces a contrast"},{"leftId":"b","left":"Therefore","rightId":"y","right":"introduces a result"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","contrast"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"However contrasts ideas; Therefore presents the consequence."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-008","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":2,"instructions":"Match each claim with a concrete example.","prompt":"Match community claims with examples.","pairs":[{"leftId":"a","left":"Libraries support learners","rightId":"x","right":"students can study there after school"},{"leftId":"b","left":"Parks improve health","rightId":"y","right":"residents can walk and play outside"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","examples"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"The examples make each general claim specific."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-009","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":2,"instructions":"Match each audience with a suitable topic.","prompt":"Match likely readers with an article topic.","pairs":[{"leftId":"a","left":"School magazine readers","rightId":"x","right":"better school clubs"},{"leftId":"b","left":"Town newsletter readers","rightId":"y","right":"safer local streets"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","audience"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"The topic should fit the interests of the intended readers."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-010","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":2,"instructions":"Match each phrase with the idea it supports.","prompt":"Match useful phrases with their paragraph purpose.","pairs":[{"leftId":"a","left":"For instance","rightId":"x","right":"adds an example"},{"leftId":"b","left":"In conclusion","rightId":"y","right":"closes the argument"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","phrases"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"Both phrases help the reader follow the article's structure."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-011","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":3,"instructions":"Match each thesis with its supporting reason.","prompt":"Match practical proposals with reasons.","pairs":[{"leftId":"a","left":"Schools should teach cooking","rightId":"x","right":"it builds everyday independence"},{"leftId":"b","left":"Towns should plant trees","rightId":"y","right":"they provide shade in summer"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","thesis"],"estimatedSeconds":50,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"Each reason directly supports the proposal it follows."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-012","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":3,"instructions":"Match each sentence with its logical result.","prompt":"Match changes with their likely results.","pairs":[{"leftId":"a","left":"More people cycle","rightId":"x","right":"traffic may decrease"},{"leftId":"b","left":"The library stays open later","rightId":"y","right":"more workers can visit"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","results"],"estimatedSeconds":50,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"The matches express plausible consequences that can support an opinion."},
    {"schemaVersion":"1.0.0","id":"b1-writing-opinion-m-013","status":"published","autoGradable":true,"level":"B1","type":"matching","category":"guided-writing","topic":"b1-writing-opinion-article","subtopic":"b1-writing-opinion-article","taxonomyNodeIds":["b1-writing-opinion-article"],"difficulty":3,"instructions":"Match each weakness with a balanced response.","prompt":"Match concerns about proposals with reasonable replies.","pairs":[{"leftId":"a","left":"New cycle lanes cost money","rightId":"x","right":"safer travel may justify the cost"},{"leftId":"b","left":"Clubs need staff","rightId":"y","right":"short sessions could share resources"}],"lessonIds":["b1-writing-opinion-article"],"tags":["b1","opinion","balance"],"estimatedSeconds":50,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"x"},{"leftId":"b","rightId":"y"}]},"explanation":"A balanced article acknowledges a concern and answers it proportionately."},
