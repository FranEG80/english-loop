      "difficulty": 2,
      "instructions": "Colócate en el carril de la respuesta correcta antes de cruzar cada puerta.",
      "prompt": "Partida de 8 rondas para repasar el tema jugando.",
      "game": "lane_runner",
      "rounds": [
        {
          "id": "r1",
          "prompt": "The consultant will ___ on Monday morning.",
          "options": [
            {
              "id": "b",
              "text": "do a presentation"
            },
            {
              "id": "d",
              "text": "have a presentation"
            },
            {
              "id": "c",
              "text": "take a presentation"
            }
          ],
          "explanation": "British English prefers «do a presentation» when you deliver it yourself."
        },
        {
          "id": "r2",
          "prompt": "Our team will ___ with the supplier on Thursday.",
          "options": [
            {
              "id": "b",
              "text": "make a meeting"
            },
            {
              "id": "a",
              "text": "do a meeting"
            },
            {
              "id": "c",
              "text": "have a meeting"
            }
          ],
          "explanation": "«Have a meeting» follows the pattern «have + event»."
        },
        {
          "id": "r3",
          "prompt": "Our department must ___ before the budget is approved.",
          "options": [
            {
              "id": "a",
              "text": "do costs"
            },
            {
              "id": "b",
              "text": "cut costs"
            },
            {
              "id": "c",
              "text": "make costs"
            }
          ],
          "explanation": "«Cut costs» is the standard business collocation for reducing spending."
        },
        {
          "id": "r4",
