    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-001","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":1,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the beginnings and endings about a school project.","passage":"The class is describing how its recycling project developed.","pairs":[{"leftId":"a","left":"The pupils counted the bottles","rightId":"1","right":"before choosing a collection point."},{"leftId":"b","left":"They chose the playground shed","rightId":"2","right":"because it had enough space."},{"leftId":"c","left":"This decision meant","rightId":"3","right":"that the boxes stayed dry."},{"leftId":"d","left":"As a result, the project","rightId":"4","right":"continued during rainy weeks."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","matching"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"Each ending follows the reference and cause-effect sequence in the short account."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-002","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":1,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the bus announcement.","passage":"The notice explains a temporary bus change.","pairs":[{"leftId":"a","left":"The main road is closed","rightId":"1","right":"because of roadworks."},{"leftId":"b","left":"Buses now use a side street","rightId":"2","right":"near the market."},{"leftId":"c","left":"This route is narrower","rightId":"3","right":"than the usual road."},{"leftId":"d","left":"Passengers should allow","rightId":"4","right":"ten extra minutes."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","transport"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The endings preserve the explanation of the road closure and its consequence."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-003","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":1,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the garden report.","passage":"The report follows a community garden from planning to harvest.","pairs":[{"leftId":"a","left":"The volunteers marked the beds","rightId":"1","right":"before buying seeds."},{"leftId":"b","left":"This plan helped them","rightId":"2","right":"use the small area carefully."},{"leftId":"c","left":"They planted lettuce first","rightId":"3","right":"because it grows quickly."},{"leftId":"d","left":"The first harvest therefore","rightId":"4","right":"arrived before the summer holiday."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","garden"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The matches follow the planning, reason and result sequence."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-004","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":1,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the clauses in the library update.","passage":"The library has changed how visitors borrow magazines.","pairs":[{"leftId":"a","left":"The old shelf was too crowded","rightId":"1","right":"for new issues."},{"leftId":"b","left":"The librarian moved it","rightId":"2","right":"beside the reading tables."},{"leftId":"c","left":"This made the display","rightId":"3","right":"easier to browse."},{"leftId":"d","left":"Visitors now find","rightId":"4","right":"the latest magazines quickly."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","library"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The pronoun and result phrases match the library changes in order."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-005","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":1,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the cooking instructions.","passage":"The instructions describe how to prepare a simple soup.","pairs":[{"leftId":"a","left":"First, chop the vegetables","rightId":"1","right":"into small pieces."},{"leftId":"b","left":"This helps them","rightId":"2","right":"cook at the same speed."},{"leftId":"c","left":"Then add the stock","rightId":"3","right":"and leave it to simmer."},{"leftId":"d","left":"Finally, blend the soup","rightId":"4","right":"until it becomes smooth."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","instructions"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The matches preserve both the instruction order and the reference in each sentence."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-006","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":2,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the neighbourhood survey.","passage":"Residents answered questions about a new crossing.","pairs":[{"leftId":"a","left":"Many people supported the crossing","rightId":"1","right":"near the school."},{"leftId":"b","left":"However, some drivers worried","rightId":"2","right":"about longer journeys."},{"leftId":"c","left":"The survey recorded both views","rightId":"3","right":"rather than only one opinion."},{"leftId":"d","left":"This information will help","rightId":"4","right":"the council plan a safe route."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","survey"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The contrast and final reference depend on the ideas established in the earlier clauses."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-007","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":2,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the museum story.","passage":"A museum describes an unexpectedly busy afternoon.","pairs":[{"leftId":"a","left":"The museum expected few visitors","rightId":"1","right":"because it was raining."},{"leftId":"b","left":"Instead, a family event","rightId":"2","right":"attracted a large crowd."},{"leftId":"c","left":"The staff opened another room","rightId":"3","right":"to reduce the queue."},{"leftId":"d","left":"As a result, visitors","rightId":"4","right":"spent less time waiting."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","museum"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The pairs establish expectation, contrast, action and result."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-008","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":2,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the office notice.","passage":"An office explains its new recycling labels.","pairs":[{"leftId":"a","left":"Each bin has a picture","rightId":"1","right":"of the material it accepts."},{"leftId":"b","left":"The labels are larger","rightId":"2","right":"than the old ones."},{"leftId":"c","left":"This change should prevent","rightId":"3","right":"mistakes during busy hours."},{"leftId":"d","left":"The cleaners will review","rightId":"4","right":"the results next month."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","office"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The pronoun *this change* refers to the larger labels, while the final action follows the trial."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-009","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":2,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the travel diary.","passage":"A traveller describes a delayed journey to the coast.","pairs":[{"leftId":"a","left":"The first train stopped","rightId":"1","right":"outside the station."},{"leftId":"b","left":"Because of this delay","rightId":"2","right":"we missed our connection."},{"leftId":"c","left":"The next service was full","rightId":"3","right":"so we stood near the door."},{"leftId":"d","left":"Despite the problems","rightId":"4","right":"we reached the beach by noon."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","travel"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The causal and concessive links make the journey sequence coherent."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-010","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":2,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the volunteer report.","passage":"The report describes how volunteers prepared a charity sale.","pairs":[{"leftId":"a","left":"They checked the donated items","rightId":"1","right":"for damage."},{"leftId":"b","left":"Anything unsuitable was put aside","rightId":"2","right":"for another organisation."},{"leftId":"c","left":"This meant the sale included","rightId":"3","right":"only useful products."},{"leftId":"d","left":"The remaining items were arranged","rightId":"4","right":"by type and size."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","charity"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The pronouns and result marker connect the sorting stages clearly."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-011","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":3,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the walking-group update.","passage":"A walking group explains why it chose a new route.","pairs":[{"leftId":"a","left":"The usual path crossed a field","rightId":"1","right":"that flooded after heavy rain."},{"leftId":"b","left":"The leader therefore suggested","rightId":"2","right":"a route beside the canal."},{"leftId":"c","left":"This alternative was longer","rightId":"3","right":"but much safer."},{"leftId":"d","left":"Most members accepted","rightId":"4","right":"the change immediately."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","route"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The reason, proposal, contrast and reaction form one continuous argument."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-012","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":3,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the after-school notice.","passage":"The school is explaining a change to its homework club.","pairs":[{"leftId":"a","left":"The club now starts earlier","rightId":"1","right":"on Tuesday afternoons."},{"leftId":"b","left":"This gives pupils more time","rightId":"2","right":"to use the computers."},{"leftId":"c","left":"The room is still shared","rightId":"3","right":"with the art group."},{"leftId":"d","left":"For that reason, places","rightId":"4","right":"must be booked in advance."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","school"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The time change, its benefit and the room restriction lead to the booking rule."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-013","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":3,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the café review.","passage":"The reviewer describes a café that changed its service.","pairs":[{"leftId":"a","left":"The café replaced paper menus","rightId":"1","right":"with a small card at each table."},{"leftId":"b","left":"Some customers disliked this","rightId":"2","right":"because the print was tiny."},{"leftId":"c","left":"The manager responded","rightId":"3","right":"by adding larger copies."},{"leftId":"d","left":"The compromise means","rightId":"4","right":"everyone can read the choices."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","review"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The demonstratives and response sequence make the customer feedback coherent."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-014","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":3,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the music-event report.","passage":"The report explains how a small concert avoided a problem.","pairs":[{"leftId":"a","left":"The forecast predicted rain","rightId":"1","right":"for the evening."},{"leftId":"b","left":"The organisers moved the stage","rightId":"2","right":"under a covered market."},{"leftId":"c","left":"This arrangement protected","rightId":"3","right":"the instruments and performers."},{"leftId":"d","left":"The audience consequently","rightId":"4","right":"stayed dry during the show."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","event"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The location change explains the protection and the audience's experience."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-015","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":3,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the repair story.","passage":"A resident describes a leaking roof and its repair.","pairs":[{"leftId":"a","left":"Water appeared in the hall","rightId":"1","right":"after a storm."},{"leftId":"b","left":"The owner first covered the roof","rightId":"2","right":"with a temporary sheet."},{"leftId":"c","left":"This stopped the leak","rightId":"3","right":"until a builder arrived."},{"leftId":"d","left":"The permanent repair was finished","rightId":"4","right":"two days later."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","repair"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The temporary measure and later repair create a clear time sequence."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-016","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":4,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the transport proposal.","passage":"The proposal compares a bus lane with a cycle lane.","pairs":[{"leftId":"a","left":"The first option would help buses","rightId":"1","right":"during the morning rush."},{"leftId":"b","left":"The second would give cyclists","rightId":"2","right":"a continuous route."},{"leftId":"c","left":"Both alternatives require","rightId":"3","right":"space currently used for parking."},{"leftId":"d","left":"The council will decide","rightId":"4","right":"after a public consultation."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","proposal"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The comparison and final decision depend on matching each option with its consequence."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-017","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":4,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the learning report.","passage":"A learner explains how a weekly study plan helped.","pairs":[{"leftId":"a","left":"She divided the work","rightId":"1","right":"into short daily sessions."},{"leftId":"b","left":"This routine made it","rightId":"2","right":"easier to remember new words."},{"leftId":"c","left":"She also reviewed mistakes","rightId":"3","right":"from earlier tests."},{"leftId":"d","left":"As a result, her confidence","rightId":"4","right":"grew before the exam."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","study"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The routine, extra review and result form a connected account of improvement."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-018","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":4,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the local news item.","passage":"A local news item describes a new water-saving scheme.","pairs":[{"leftId":"a","left":"Several flats installed meters","rightId":"1","right":"to monitor daily use."},{"leftId":"b","left":"The information showed","rightId":"2","right":"where most water was wasted."},{"leftId":"c","left":"Residents then repaired","rightId":"3","right":"the oldest taps."},{"leftId":"d","left":"Their bills fell slightly","rightId":"4","right":"during the following month."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","news"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The measured information leads to the repairs and the later result."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-019","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":4,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the market announcement.","passage":"The market is explaining a change to its delivery service.","pairs":[{"leftId":"a","left":"Orders made before midday","rightId":"1","right":"will leave on the same day."},{"leftId":"b","left":"This deadline allows staff","rightId":"2","right":"to prepare the boxes properly."},{"leftId":"c","left":"Later orders are collected","rightId":"3","right":"the following morning."},{"leftId":"d","left":"Customers can therefore track","rightId":"4","right":"two separate delivery groups."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","market"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The deadline, preparation reason and two groups are linked by the time distinction."},
    {"schemaVersion":"1.0.0","id":"b1-reading-text-cohesion-rm-020","status":"published","autoGradable":true,"level":"B1","type":"reading_matching","category":"reading","topic":"b1-reading-text-cohesion","subtopic":"b1-reading-text-cohesion","taxonomyNodeIds":["b1-reading-text-cohesion"],"difficulty":4,"instructions":"Match each sentence beginning with its ending.","prompt":"Match the parts of the public meeting summary.","passage":"The summary records a meeting about a playground.","pairs":[{"leftId":"a","left":"Parents requested more shade","rightId":"1","right":"near the seats."},{"leftId":"b","left":"The architect agreed","rightId":"2","right":"that summer temperatures were a problem."},{"leftId":"c","left":"She proposed planting trees","rightId":"3","right":"beside the main path."},{"leftId":"d","left":"The group will discuss","rightId":"4","right":"the cost at the next meeting."}],"lessonIds":["b1-reading-text-cohesion"],"tags":["b1","reading","meeting"],"estimatedSeconds":45,"evaluator":{"strategy":"matching_pairs","pairs":[{"leftId":"a","rightId":"1"},{"leftId":"b","rightId":"2"},{"leftId":"c","rightId":"3"},{"leftId":"d","rightId":"4"}]},"explanation":"The proposal responds to the concern, while the final clause carries the discussion forward."},
