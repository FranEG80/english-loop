    {"schemaVersion":"1.0.0","id":"b1-reading-gapped-text-wo-004","status":"published","autoGradable":true,"level":"B1","type":"word_order","category":"reading","topic":"b1-reading-gapped-text","subtopic":"b1-reading-gapped-text","taxonomyNodeIds":["b1-reading-gapped-text"],"difficulty":1,"instructions":"Put the words in the correct order.","prompt":"Arrange the sentence about a result.","tokens":[{"id":"t1","text":"The path was flooded."},{"id":"t2","text":"As a result,"},{"id":"t3","text":"we took the road."}],"lessonIds":["b1-reading-gapped-text-cohesion"],"tags":["b1","reading","result"],"estimatedSeconds":35,"evaluator":{"strategy":"ordered_tokens","correctTokenIds":["t1","t2","t3"]},"explanation":"As a result connects the flood with the decision to use another road."},
    {"schemaVersion":"1.0.0","id":"b1-reading-gapped-text-wo-005","status":"published","autoGradable":true,"level":"B1","type":"word_order","category":"reading","topic":"b1-reading-gapped-text","subtopic":"b1-reading-gapped-text","taxonomyNodeIds":["b1-reading-gapped-text"],"difficulty":1,"instructions":"Put the words in the correct order.","prompt":"Arrange the sentence about an instruction.","tokens":[{"id":"t1","text":"First,"},{"id":"t2","text":"read the question"},{"id":"t3","text":"before choosing an answer."}],"lessonIds":["b1-reading-gapped-text-cohesion"],"tags":["b1","reading","instruction"],"estimatedSeconds":35,"evaluator":{"strategy":"ordered_tokens","correctTokenIds":["t1","t2","t3"]},"explanation":"First marks the first step in the reading strategy."},
