{
  "schemaVersion":"1.0.0","batchId":"b1-error-correction-error-correction-001","level":"B1","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","lessonId":"b1-use-of-english-error-correction","activityType":"error_correction",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-001","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Rewrite the sentence correctly.","prompt":"She go to work by bus every day.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","agreement"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"She goes to work by bus every day","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The third-person singular subject «she» takes «goes»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-002","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Rewrite the sentence correctly.","prompt":"They lives near the station.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","agreement"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"They live near the station","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The plural subject «they» takes the base form «live»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-003","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Rewrite the sentence correctly.","prompt":"He don't eat meat.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","auxiliaries"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"He doesn't eat meat","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The negative present simple with «he» uses «doesn't»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-004","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Rewrite the sentence correctly.","prompt":"I need a information about the course.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","articles"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"I need some information about the course","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Information» is uncountable, so «some information» is natural."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-005","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Rewrite the sentence correctly.","prompt":"We arrived in the airport at noon.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","prepositions"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"We arrived at the airport at noon","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"We arrive «at the airport»; «in» is used with cities or countries."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-006","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Rewrite the sentence correctly.","prompt":"I have seen that film yesterday.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","tenses"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"I saw that film yesterday","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"A finished time like «yesterday» takes past simple «saw»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-007","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Rewrite the sentence correctly.","prompt":"Did you went to the appointment?","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","auxiliaries"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"Did you go to the appointment?","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"After «did» we use the base form «go»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-008","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Rewrite the sentence correctly.","prompt":"She is interested on photography.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","prepositions"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"She is interested in photography","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The adjective «interested» takes the preposition «in»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-009","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Rewrite the sentence correctly.","prompt":"There is too much cars outside the school.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","quantifiers"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"There are too many cars outside the school","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Cars» is plural countable, so use «many» and «there are»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-010","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Rewrite the sentence correctly.","prompt":"Can you tell me where is the bank?","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","indirect-questions"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"Can you tell me where the bank is?","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"An indirect question uses statement order after «where»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-011","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Rewrite the sentence correctly.","prompt":"Although of the rain, the match continued.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","linkers"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"Although it was raining, the match continued","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Although» needs a clause; «despite the rain» would be the noun phrase alternative."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-012","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Rewrite the sentence correctly.","prompt":"He has worked here since five years.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","time"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"He has worked here for five years","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"A duration takes «for», not «since»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-013","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Rewrite the sentence correctly.","prompt":"The letter was send last Tuesday.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","passive"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"The letter was sent last Tuesday","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The past participle of «send» is «sent»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-014","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Rewrite the sentence correctly.","prompt":"She explained me the booking rules.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","verb-patterns"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"She explained the booking rules to me","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Explain» takes the thing directly and the person after «to»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-015","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Rewrite the sentence correctly.","prompt":"I am looking forward to meet you.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","verb-patterns"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"I am looking forward to meeting you","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"In «look forward to», the preposition «to» is followed by a gerund."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-016","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Rewrite the sentence correctly.","prompt":"If I would have more time, I would join the course.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","conditionals"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"If I had more time, I would join the course","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The second conditional uses past simple in the if-clause, not «would»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-017","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Rewrite the sentence correctly.","prompt":"It was so a useful workshop that I took notes.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","so-such"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"It was such a useful workshop that I took notes","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"Before a noun phrase use «such a», not «so a»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-018","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Rewrite the sentence correctly.","prompt":"The manager asked where did I leave the key.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","indirect-questions"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"The manager asked where I left the key","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The indirect question has statement order «where I left»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-019","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Rewrite the sentence correctly.","prompt":"She said that she will call me tomorrow.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","reported-speech"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"She said that she would call me the next day","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"After past «said», «will» becomes «would» and «tomorrow» becomes «the next day»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-020","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Rewrite the sentence correctly.","prompt":"I wish I would have checked the timetable.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","wish"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"I wish I had checked the timetable","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"Past regret uses past perfect «had checked», not «would have checked» after «wish»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-021","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Rewrite the sentence correctly.","prompt":"No sooner had the film started when the power failed.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","inversion"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"No sooner had the film started than the power failed","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The fixed pair is «no sooner ... than»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-022","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Rewrite the sentence correctly.","prompt":"The instructions apply for everyone in the room.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","prepositions"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"The instructions apply to everyone in the room","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The verb «apply» takes the preposition «to»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-023","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Rewrite the sentence correctly.","prompt":"The bridge is believed to have build in 1800.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","passive-reporting"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"The bridge is believed to have been built in 1800","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The completed passive needs «to have been built»."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-024","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Rewrite the sentence correctly.","prompt":"Despite of being tired, the nurse finished her shift.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","linkers"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"Despite being tired, the nurse finished her shift","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Despite» is not followed by «of»; it can take a noun or gerund directly."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-ec-025","status":"published","autoGradable":true,"level":"B1","type":"error_correction","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Rewrite the sentence correctly.","prompt":"The evidence is consistent to the earlier report.","lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","prepositions"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"The evidence is consistent with the earlier report","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The collocation is «consistent with»."}
  ]
