{
  "schemaVersion":"1.0.0","batchId":"b1-error-correction-single-choice-001","level":"B1","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","lessonId":"b1-use-of-english-error-correction","activityType":"single_choice",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-001","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Choose the correct sentence.","prompt":"Which sentence is correct?","options":[{"id":"a","text":"She walk to work."},{"id":"b","text":"She walks to work."},{"id":"c","text":"She walking to work."},{"id":"d","text":"She does walks to work."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","agreement"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"«She walks» has the correct third-person singular form."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-002","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses an article correctly?","options":[{"id":"a","text":"I saw an dog."},{"id":"b","text":"I saw a dog."},{"id":"c","text":"I saw dog."},{"id":"d","text":"I saw a dogs."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","articles"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The singular countable noun «dog» takes «a» before its consonant sound."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-003","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses the past simple correctly?","options":[{"id":"a","text":"They go yesterday."},{"id":"b","text":"They went yesterday."},{"id":"c","text":"They gone yesterday."},{"id":"d","text":"They going yesterday."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","past-simple"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The irregular past of «go» is «went». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-004","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Choose the correct sentence.","prompt":"Which negative sentence is correct?","options":[{"id":"a","text":"He don't drive."},{"id":"b","text":"He doesn't drive."},{"id":"c","text":"He doesn't drives."},{"id":"d","text":"He not drive."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","negatives"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"«Doesn't» is followed by the base form «drive». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-005","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":1,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses a preposition correctly?","options":[{"id":"a","text":"We arrived at the station."},{"id":"b","text":"We arrived in the station."},{"id":"c","text":"We arrived on the station."},{"id":"d","text":"We arrived to the station."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","prepositions"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The usual phrase is «arrive at the station». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-006","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses present perfect correctly?","options":[{"id":"a","text":"I have lived here since 2020."},{"id":"b","text":"I have lived here for 2020."},{"id":"c","text":"I live here since 2020."},{"id":"d","text":"I lived here since 2020."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","present-perfect"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A starting year takes «since» with present perfect."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-007","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Choose the correct sentence.","prompt":"Which question is correct?","options":[{"id":"a","text":"Did she went home?"},{"id":"b","text":"Did she go home?"},{"id":"c","text":"Did she goes home?"},{"id":"d","text":"Did she going home?"}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","questions"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"After «did», use the base form «go». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-008","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Choose the correct sentence.","prompt":"Which indirect question is correct?","options":[{"id":"a","text":"Do you know where is the post office?"},{"id":"b","text":"Do you know where the post office is?"},{"id":"c","text":"Do you know where does the post office is?"},{"id":"d","text":"Do you know where the post office?"}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","indirect-questions"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The indirect question uses statement order: «where the post office is». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-009","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses «for» correctly?","options":[{"id":"a","text":"She has worked here for three years."},{"id":"b","text":"She has worked here since three years."},{"id":"c","text":"She works here for three years."},{"id":"d","text":"She worked here for 2020."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","time"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A duration such as «three years» takes «for». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-010","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":2,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses a countable noun correctly?","options":[{"id":"a","text":"There are much cars."},{"id":"b","text":"There are many cars."},{"id":"c","text":"There is many cars."},{"id":"d","text":"There are a cars."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","quantifiers"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"«Cars» is plural countable, so use «many» and «there are». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-011","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses «although» correctly?","options":[{"id":"a","text":"Although the rain, we walked."},{"id":"b","text":"Although it was raining, we walked."},{"id":"c","text":"Although of raining, we walked."},{"id":"d","text":"Although was raining, we walked."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","linkers"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"«Although» introduces a complete clause with a subject and verb."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-012","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Choose the correct sentence.","prompt":"Which passive sentence is correct?","options":[{"id":"a","text":"The form was sign yesterday."},{"id":"b","text":"The form was signed yesterday."},{"id":"c","text":"The form is signed yesterday."},{"id":"d","text":"The form was signing yesterday."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","passive"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The past passive is «was signed». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-013","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Choose the correct sentence.","prompt":"Which verb pattern is correct?","options":[{"id":"a","text":"She explained me the rule."},{"id":"b","text":"She explained the rule to me."},{"id":"c","text":"She explained to me the rule."},{"id":"d","text":"She explained me to the rule."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","verb-patterns"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"«Explain» takes the thing directly and the person after «to». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-014","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Choose the correct sentence.","prompt":"Which reported statement is correct?","options":[{"id":"a","text":"Mia said that she was busy."},{"id":"b","text":"Mia said me that she was busy."},{"id":"c","text":"Mia told that she was busy."},{"id":"d","text":"Mia said that she is busy yesterday."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","reported-speech"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Use «said that» without a direct person object."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-015","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":3,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses «look forward to» correctly?","options":[{"id":"a","text":"I look forward to meet you."},{"id":"b","text":"I look forward to meeting you."},{"id":"c","text":"I look forward meeting you."},{"id":"d","text":"I look forward to met you."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","gerunds"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The preposition «to» is followed by the gerund «meeting». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-016","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Choose the correct sentence.","prompt":"Which conditional sentence is correct?","options":[{"id":"a","text":"If I would have time, I join."},{"id":"b","text":"If I had time, I would join."},{"id":"c","text":"If I have time, I would joined."},{"id":"d","text":"If I had time, I join would."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","conditionals"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The second conditional uses «if + past simple» and «would + base verb». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-017","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses «such» correctly?","options":[{"id":"a","text":"It was such a useful book that I kept it."},{"id":"b","text":"It was so a useful book that I kept it."},{"id":"c","text":"It was such useful that I kept it."},{"id":"d","text":"It such was a useful book that I kept it."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","so-such"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The pattern is «such + a/an + adjective + singular noun». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-018","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Choose the correct sentence.","prompt":"Which indirect question reports a past action correctly?","options":[{"id":"a","text":"She asked where did I leave it."},{"id":"b","text":"She asked where I had left it."},{"id":"c","text":"She asked where had I left it."},{"id":"d","text":"She asked where I leave had it."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","indirect-questions"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Indirect questions use statement order and past perfect for the earlier action."},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-019","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Choose the correct sentence.","prompt":"Which sentence reports a future plan correctly?","options":[{"id":"a","text":"He said that he would call the next day."},{"id":"b","text":"He said that he will called the next day."},{"id":"c","text":"He told that he would call tomorrow."},{"id":"d","text":"He said me he would call the next day."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","reported-speech"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The correct sequence is «said that + would call + the next day». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-020","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":4,"instructions":"Choose the correct sentence.","prompt":"Which sentence expresses past regret correctly?","options":[{"id":"a","text":"I wish I checked the map."},{"id":"b","text":"I wish I had checked the map."},{"id":"c","text":"I wish I would checked the map."},{"id":"d","text":"I wish I have checked the map."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","wish"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Past regret uses «wish + past perfect»: «had checked». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-021","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Choose the correct sentence.","prompt":"Which reporting passive is correct?","options":[{"id":"a","text":"The tunnel is believed to be safe."},{"id":"b","text":"The tunnel is believed be safe."},{"id":"c","text":"The tunnel believed to be safe."},{"id":"d","text":"The tunnel is believing to be safe."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","passive-reporting"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The reporting passive requires «is believed to be». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-022","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Choose the correct sentence.","prompt":"Which fixed expression is correct?","options":[{"id":"a","text":"No sooner had we arrived than it started raining."},{"id":"b","text":"No sooner had we arrived when it started raining."},{"id":"c","text":"No sooner we had arrived than it started raining."},{"id":"d","text":"No sooner did we arrived than it started raining."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","inversion"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The fixed pattern is «no sooner had ... than ...». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-023","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses «consistent» correctly?","options":[{"id":"a","text":"The figures are consistent with the report."},{"id":"b","text":"The figures are consistent to the report."},{"id":"c","text":"The figures consistent with the report."},{"id":"d","text":"The figures are consistency with the report."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","prepositions"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"The collocation is «consistent with». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-024","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Choose the correct sentence.","prompt":"Which sentence uses «despite» correctly?","options":[{"id":"a","text":"Despite the delay, we caught the train."},{"id":"b","text":"Despite of the delay, we caught the train."},{"id":"c","text":"Despite it was delayed, we caught the train."},{"id":"d","text":"Despite the train was late, we caught it."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","linkers"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Despite» can be followed by the noun phrase «the delay» without «of». "},
    {"schemaVersion":"1.0.0","id":"b1-error-correction-sc-025","status":"published","autoGradable":true,"level":"B1","type":"single_choice","category":"use-of-english","topic":"b1-error-correction","subtopic":"b1-error-correction","taxonomyNodeIds":["b1-error-correction"],"difficulty":5,"instructions":"Choose the correct sentence.","prompt":"Which modal passive is correct?","options":[{"id":"a","text":"The form must be signed today."},{"id":"b","text":"The form must signed today."},{"id":"c","text":"The form must be sign today."},{"id":"d","text":"The form must be signing today."}],"lessonIds":["b1-use-of-english-error-correction"],"tags":["b1","error-correction","passive"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"A modal passive is «must + be + past participle»: «must be signed». "}
  ]
}
