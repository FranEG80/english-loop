{
  "schemaVersion":"1.0.0","batchId":"b1-sentence-rewriting-key-word-transformation-001","level":"B1","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","lessonId":"b1-use-of-english-sentence-rewriting","activityType":"key_word_transformation",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-001","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":1,"instructions":"Complete the second sentence using the key word.","prompt":"The green coat is cheaper than the black coat. The black coat is ___ the green coat. (EXPENSIVE)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","comparatives"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"more expensive than","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The opposite comparison uses «more expensive than»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-002","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":1,"instructions":"Complete the second sentence using the key word.","prompt":"Someone washes the uniforms every Friday. The uniforms are ___ every Friday. (WASHED)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","passive"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"washed","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The passive phrase is «are washed»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-003","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":1,"instructions":"Complete the second sentence using the key word.","prompt":"“I am late,” Kim said. Kim said that she was ___. (LATE)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","reported-speech"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"late","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The adjective remains «late» while the reporting clause changes the pronoun and verb."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-004","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":1,"instructions":"Complete the second sentence using the key word.","prompt":"I began this job in April. I have worked here ___ April. (SINCE)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","present-perfect"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"since","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"A starting month is introduced with «since»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-005","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":1,"instructions":"Complete the second sentence using the key word.","prompt":"The table is too narrow for four plates. The table is not ___ for four plates. (WIDE)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","too-enough"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"wide enough","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The equivalent form is «not wide enough»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-006","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":2,"instructions":"Complete the second sentence using the key word.","prompt":"The metro is faster than the tram. The tram is not ___ the metro. (FAST)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","comparatives"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"as fast as","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The reverse comparison is «not as fast as»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-007","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":2,"instructions":"Complete the second sentence using the key word.","prompt":"They painted the hall last weekend. The hall was ___ last weekend. (PAINTED)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","passive"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"painted","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The past passive is «was painted»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-008","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":2,"instructions":"Complete the second sentence using the key word.","prompt":"“I will email you,” Max said. Max said that he would email ___. (ME)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","reported-speech"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"me","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The original «you» refers to the reporter, so it becomes «me»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-009","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":2,"instructions":"Complete the second sentence using the key word.","prompt":"I last saw the play in May. I have not seen it ___ May. (SINCE)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","present-perfect"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"since","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The last occurrence gives the starting point «since May»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-010","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":2,"instructions":"Complete the second sentence using the key word.","prompt":"The suitcase is too heavy for the shelf. The shelf is not ___ for the suitcase. (STRONG)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","too-enough"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"strong enough","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The equivalent ability is expressed with «not strong enough»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-011","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":3,"instructions":"Complete the second sentence using the key word.","prompt":"People say that the park is safe at night. The park is ___ safe at night. (SAID)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","passive-reporting"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"said to be","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The reporting passive is «is said to be safe»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-012","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":3,"instructions":"Complete the second sentence using the key word.","prompt":"The silver path is less steep than the red path. The red path is not ___ the silver path. (EASY)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","comparatives"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"as easy as","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"A less steep path is easier, so the reverse is «not as easy as»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-013","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":3,"instructions":"Complete the second sentence using the key word.","prompt":"The company has installed new lights. New lights have ___ by the company. (INSTALLED)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","passive"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"been installed","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The present perfect passive uses «have been installed»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-014","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":3,"instructions":"Complete the second sentence using the key word.","prompt":"“I can cover the afternoon shift,” Luis told Sara. Luis told Sara that he could cover ___. (SHIFT)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","reported-speech"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"the afternoon shift","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The noun phrase stays the same while «can» changes to «could»."},
