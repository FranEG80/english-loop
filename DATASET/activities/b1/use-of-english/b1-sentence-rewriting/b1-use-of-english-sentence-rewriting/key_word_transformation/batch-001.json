    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-016","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":4,"instructions":"Complete the second sentence using the key word.","prompt":"The wind was so strong that the boats stayed in harbour. The wind was ___ for the boats to leave. (TOO)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","too-enough"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"too strong","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The cause of the result is expressed as «too strong for the boats to leave»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-017","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":4,"instructions":"Complete the second sentence using the key word.","prompt":"The chef prepared the meal. The meal was ___ the chef. (BY)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","passive"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"prepared by","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The agent in a passive sentence is introduced by «by»."},
