    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-020","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":4,"instructions":"Complete the second sentence using the key word.","prompt":"The instructions were so confusing that I called the office. They were ___ instructions that I called the office. (SUCH)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","so-such"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"such confusing","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The adjective moves before the noun after «such»."},
    {"schemaVersion":"1.0.0","id":"b1-sentence-rewriting-kwt-021","status":"published","autoGradable":true,"level":"B1","type":"key_word_transformation","category":"use-of-english","topic":"b1-sentence-rewriting","subtopic":"b1-sentence-rewriting","taxonomyNodeIds":["b1-sentence-rewriting"],"difficulty":5,"instructions":"Complete the second sentence using the key word.","prompt":"People believe that the old tunnel is unsafe. The old tunnel is ___ unsafe. (BELIEVED)","lessonIds":["b1-use-of-english-sentence-rewriting"],"tags":["b1","rewriting","passive-reporting"],"estimatedSeconds":60,"evaluator":{"strategy":"exact_text","answer":"believed to be","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The reporting passive uses «is believed to be unsafe»."},
