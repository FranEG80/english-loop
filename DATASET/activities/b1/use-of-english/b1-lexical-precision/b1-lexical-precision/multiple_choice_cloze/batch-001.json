{
  "schemaVersion":"1.0.0","batchId":"b1-lexical-precision-multiple-choice-cloze-001","level":"B1","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","lessonId":"b1-lexical-precision","activityType":"multiple_choice_cloze",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-001","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":1,"instructions":"Choose the word that completes the sentence naturally.","prompt":"Before you leave the classroom, please ___ the lights.","options":[{"id":"a","text":"turn off"},{"id":"b","text":"take off"},{"id":"c","text":"put out"},{"id":"d","text":"break off"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","phrasal-verbs"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"La combinación natural para apagar las luces es «turn off»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-002","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":1,"instructions":"Choose the word that completes the sentence naturally.","prompt":"After the long walk, we ___ a short break by the lake.","options":[{"id":"a","text":"did"},{"id":"b","text":"made"},{"id":"c","text":"took"},{"id":"d","text":"had to"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","collocation"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"La colocación habitual es «take a break», cuyo pasado es «took a break»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-003","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":1,"instructions":"Choose the correct preposition.","prompt":"The train arrived ___ time, so we did not miss the opening talk.","options":[{"id":"a","text":"in"},{"id":"b","text":"on"},{"id":"c","text":"at"},{"id":"d","text":"by"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","prepositions"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"La expresión fija «on time» significa puntualmente."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-004","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":1,"instructions":"Choose the correct verb form.","prompt":"Maya ___ her homework before dinner yesterday.","options":[{"id":"a","text":"finish"},{"id":"b","text":"finishes"},{"id":"c","text":"finished"},{"id":"d","text":"has finish"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","past-simple"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"«Yesterday» points to a finished past event, so the past simple «finished» is required."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-005","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":1,"instructions":"Choose the word that completes the sentence naturally.","prompt":"The library is closed now, but it will ___ at nine tomorrow.","options":[{"id":"a","text":"open"},{"id":"b","text":"start"},{"id":"c","text":"begin up"},{"id":"d","text":"unlocking"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","daily-life"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"Después de «will» necesitamos el infinitivo «open» para indicar que el lugar abrirá."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-006","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":2,"instructions":"Choose the correct collocation.","prompt":"Could you ___ me a hand with these boxes before the van arrives?","options":[{"id":"a","text":"give"},{"id":"b","text":"make"},{"id":"c","text":"do"},{"id":"d","text":"put"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","collocation"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"La expresión «give someone a hand» significa ayudar a alguien."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-007","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":2,"instructions":"Choose the correct adjective.","prompt":"This jacket is ___ than the one I tried on earlier.","options":[{"id":"a","text":"warm"},{"id":"b","text":"warmer"},{"id":"c","text":"more warm"},{"id":"d","text":"warmest"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","comparatives"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"La comparación con «than» requiere el comparativo «warmer»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-008","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":2,"instructions":"Choose the correct preposition.","prompt":"I have lived in this neighbourhood ___ 2021.","options":[{"id":"a","text":"for"},{"id":"b","text":"during"},{"id":"c","text":"since"},{"id":"d","text":"from"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","present-perfect"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"«Since» introduces a starting point in time, here the year 2021."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-009","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":2,"instructions":"Choose the correct preposition.","prompt":"Leo apologised ___ being late for the appointment.","options":[{"id":"a","text":"at"},{"id":"b","text":"for"},{"id":"c","text":"to"},{"id":"d","text":"with"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","prepositions"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"El verbo «apologise» se combina con «for» delante de un nombre o gerundio."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-010","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":2,"instructions":"Choose the correct verb.","prompt":"The team needs to ___ a decision before the office closes.","options":[{"id":"a","text":"make"},{"id":"b","text":"do"},{"id":"c","text":"take"},{"id":"d","text":"set"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","collocation"],"estimatedSeconds":40,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"La colocación correcta es «make a decision», no «do» ni «take»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-011","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":3,"instructions":"Choose the correct linker.","prompt":"The bus was delayed, ___ we took the train instead.","options":[{"id":"a","text":"although"},{"id":"b","text":"because"},{"id":"c","text":"so"},{"id":"d","text":"unless"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","linking-words"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"La segunda parte es el resultado de la primera, por eso usamos «so»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-012","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":3,"instructions":"Choose the correct phrasal verb.","prompt":"Ella is looking ___ her younger brother while her parents work.","options":[{"id":"a","text":"for"},{"id":"b","text":"after"},{"id":"c","text":"at"},{"id":"d","text":"through"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","phrasal-verbs"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"«Look after» significa cuidar de una persona."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-013","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":3,"instructions":"Choose the correct phrasal verb.","prompt":"The form must be ___ in ink and signed at the bottom.","options":[{"id":"a","text":"filled in"},{"id":"b","text":"filled over"},{"id":"c","text":"filled through"},{"id":"d","text":"filled on"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","phrasal-verbs"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Fill in a form» es la combinación habitual para completar un formulario."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-014","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":3,"instructions":"Choose the correct quantifier.","prompt":"We cannot print all the posters because we do not have ___ paper.","options":[{"id":"a","text":"enough"},{"id":"b","text":"too"},{"id":"c","text":"many"},{"id":"d","text":"several"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","quantifiers"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Paper» es incontable y la idea es cantidad suficiente: «enough paper»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-015","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":3,"instructions":"Choose the correct phrasal verb.","prompt":"They had to ___ the meeting until the director returned.","options":[{"id":"a","text":"put off"},{"id":"b","text":"put up"},{"id":"c","text":"put through"},{"id":"d","text":"put in"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","phrasal-verbs"],"estimatedSeconds":45,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Put off» significa aplazar una actividad o reunión."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-016","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":4,"instructions":"Choose the correct form.","prompt":"Despite ___ hard all week, Priya still felt nervous before the test.","options":[{"id":"a","text":"study"},{"id":"b","text":"studied"},{"id":"c","text":"studying"},{"id":"d","text":"to study"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","gerunds"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"«Despite» va seguido aquí del gerundio «studying», no de un infinitivo."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-017","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":4,"instructions":"Choose the most natural adverb.","prompt":"The documentary was ___ engaging, so even the younger pupils watched it.","options":[{"id":"a","text":"surprise"},{"id":"b","text":"surprisingly"},{"id":"c","text":"surprised"},{"id":"d","text":"surprising"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","word-forms"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"El adverbio «surprisingly» modifica al adjetivo «engaging»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-018","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":4,"instructions":"Choose the correct conditional form.","prompt":"If I ___ you, I would check the booking details again.","options":[{"id":"a","text":"am"},{"id":"b","text":"was"},{"id":"c","text":"were"},{"id":"d","text":"would be"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","conditionals"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"En el segundo condicional se usa tradicionalmente «If I were you»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-019","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":4,"instructions":"Choose the correct infinitive pattern.","prompt":"The manager asked us ___ the figures before the presentation.","options":[{"id":"a","text":"check"},{"id":"b","text":"checking"},{"id":"c","text":"to check"},{"id":"d","text":"checked"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","verb-patterns"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"«Ask someone to do something» lleva infinitivo con «to»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-020","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":4,"instructions":"Choose the adjective that fits the context.","prompt":"The new timetable has had a ___ effect on morning traffic.","options":[{"id":"a","text":"notice"},{"id":"b","text":"noticeable"},{"id":"c","text":"noticing"},{"id":"d","text":"noticed"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","word-forms"],"estimatedSeconds":50,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"Antes del nombre «effect» necesitamos el adjetivo «noticeable»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-021","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":5,"instructions":"Choose the most precise adjective.","prompt":"After two meetings, the committee reached a ___ agreement that still needed approval.","options":[{"id":"a","text":"tentative"},{"id":"b","text":"temporary"},{"id":"c","text":"timely"},{"id":"d","text":"tender"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","meaning"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Tentative agreement» indica un acuerdo provisional, aún no definitivo."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-022","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":5,"instructions":"Choose the correct phrasal expression.","prompt":"The short report failed to ___ why the repairs cost so much.","options":[{"id":"a","text":"account for"},{"id":"b","text":"account to"},{"id":"c","text":"count on"},{"id":"d","text":"allow for"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","phrasal-verbs"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Account for» significa explicar o justificar una cantidad o hecho."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-023","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":5,"instructions":"Choose the correct tense.","prompt":"By the time we reached the platform, the train ___ already left.","options":[{"id":"a","text":"has"},{"id":"b","text":"would"},{"id":"c","text":"had"},{"id":"d","text":"was"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","past-perfect"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"c"},"explanation":"El tren salió antes de que llegáramos, así que usamos past perfect: «had left»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-024","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":5,"instructions":"Choose the correct collocation.","prompt":"During the briefing, the supervisor ___ attention to the missing safety signs.","options":[{"id":"a","text":"drew"},{"id":"b","text":"pulled"},{"id":"c","text":"made"},{"id":"d","text":"held"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","collocation"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"La colocación es «draw attention to something», cuyo pasado es «drew»."},
    {"schemaVersion":"1.0.0","id":"b1-lexical-precision-mcc-025","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-lexical-precision","subtopic":"b1-lexical-precision","taxonomyNodeIds":["b1-lexical-precision"],"difficulty":5,"instructions":"Choose the correct adjective.","prompt":"The latest figures are ___ with the estimates published in May.","options":[{"id":"a","text":"consistent"},{"id":"b","text":"considerate"},{"id":"c","text":"constant"},{"id":"d","text":"convenient"}],"lessonIds":["b1-lexical-precision"],"tags":["b1","cloze","meaning"],"estimatedSeconds":55,"evaluator":{"strategy":"single_option","correctOptionId":"a"},"explanation":"«Consistent with» significa que dos conjuntos de datos no se contradicen."}
  ]
}
