{
  "schemaVersion":"1.0.0","batchId":"b1-open-cloze-open-cloze-001","level":"B1","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","lessonId":"b1-use-of-english-open-cloze","activityType":"open_cloze",
  "activities":[
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-001","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":1,"instructions":"Complete the sentence with one word.","prompt":"I bought ___ umbrella because it was raining.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","articles"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"an","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Umbrella» begins with a vowel sound, so the indefinite article is «an»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-002","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":1,"instructions":"Complete the sentence with one word.","prompt":"The children are waiting ___ the bus outside the school.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","prepositions"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"for","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The verb «wait» takes the preposition «for» before the thing expected."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-003","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":1,"instructions":"Complete the sentence with one word.","prompt":"Marta left her keys on the table, but now she cannot find ___.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","pronouns"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"them","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Keys» is plural, so the object pronoun is «them»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-004","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":1,"instructions":"Complete the sentence with one word.","prompt":"We stayed at home ___ it was too cold to walk.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","linkers"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"because","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Because» introduces the reason for staying at home."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-005","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":1,"instructions":"Complete the sentence with one word.","prompt":"There is ___ orange in the bowl if you would like one.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","articles"],"estimatedSeconds":35,"evaluator":{"strategy":"exact_text","answer":"an","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The singular countable noun «orange» needs «an» before its vowel sound."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-006","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":2,"instructions":"Complete the sentence with one word.","prompt":"I have known Daniel ___ we were at primary school.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","time"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"since","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Since» introduces the moment when the relationship began."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-007","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":2,"instructions":"Complete the sentence with one word.","prompt":"The museum was closed, ___ we visited the park instead.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","linkers"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"so","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«So» introduces the result of the museum being closed."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-008","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":2,"instructions":"Complete the sentence with one word.","prompt":"The woman ___ lives next door is a violin teacher.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","relative-clauses"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"who","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Who» refers to the person who lives next door."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-009","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":2,"instructions":"Complete the sentence with one word.","prompt":"We have been waiting here ___ half an hour.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","time"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"for","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«For» introduces a duration such as «half an hour»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-010","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":2,"instructions":"Complete the sentence with one word.","prompt":"Could you tell me ___ the nearest pharmacy is?","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","indirect-questions"],"estimatedSeconds":40,"evaluator":{"strategy":"exact_text","answer":"where","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The indirect question asks about the place, so it begins with «where»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-011","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":3,"instructions":"Complete the sentence with one word.","prompt":"Although ___ was raining, the players continued the match.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","linkers"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"it","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The weather expression requires the dummy subject «it»: «it was raining»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-012","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":3,"instructions":"Complete the sentence with one word.","prompt":"The report explains ___ the bridge was closed for repairs.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","linkers"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"why","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The missing word introduces an explanation of the reason."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-013","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":3,"instructions":"Complete the sentence with one word.","prompt":"She asked me whether I ___ received the email.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","auxiliaries"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"had","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The past perfect question uses the auxiliary «had» before «received»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-014","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":3,"instructions":"Complete the sentence with one word.","prompt":"The keys were on the shelf, exactly where I had left ___.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","pronouns"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"them","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The pronoun refers back to plural «keys», so it must be «them»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-015","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":3,"instructions":"Complete the sentence with one word.","prompt":"You should take a coat in case the temperature ___ down later.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","phrasal-verbs"],"estimatedSeconds":45,"evaluator":{"strategy":"exact_text","answer":"goes","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The third-person singular subject «the temperature» takes «goes» in «go down»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-016","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":4,"instructions":"Complete the sentence with one word.","prompt":"It was ___ a noisy room that we moved to another table.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","so-such"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"such","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"Before the noun phrase «a noisy room» we use «such», not «so»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-017","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":4,"instructions":"Complete the sentence with one word.","prompt":"The instructions were clear enough ___ everyone could follow them.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","linkers"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"that","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The pattern «enough that» introduces the result."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-018","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":4,"instructions":"Complete the sentence with one word.","prompt":"I wish I ___ remembered to bring the printed ticket.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","wish"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"had","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"A regret about the past uses «wish + past perfect»: «wish I had remembered»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-019","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":4,"instructions":"Complete the sentence with one word.","prompt":"The manager spoke to the staff, most ___ whom had already read the memo.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","relative-clauses"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"of","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The fixed structure is «most of whom» when referring to people."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-020","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":4,"instructions":"Complete the sentence with one word.","prompt":"The café was crowded, but we managed to find a table ___ the corner.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","prepositions"],"estimatedSeconds":50,"evaluator":{"strategy":"exact_text","answer":"in","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The natural preposition for a table located in a corner is «in»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-021","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":5,"instructions":"Complete the sentence with one word.","prompt":"By the time the guests arrived, we ___ already prepared the food.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","past-perfect"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"had","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The preparation happened before another past event, so we need «had prepared»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-022","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":5,"instructions":"Complete the sentence with one word.","prompt":"No sooner had the bell rung ___ the pupils left the room.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","inversion"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"than","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The fixed pair is «no sooner ... than»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-023","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":5,"instructions":"Complete the sentence with one word.","prompt":"The building, ___ entrance was damaged, will reopen next week.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","relative-clauses"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"whose","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Whose» shows that the entrance belongs to or is part of the building."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-024","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":5,"instructions":"Complete the sentence with one word.","prompt":"The organiser cancelled the walk, not ___ the weather was dangerous, but because the guide was ill.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","linkers"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"because","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"The sentence contrasts two possible reasons and then gives the real one with «because»."},
    {"schemaVersion":"1.0.0","id":"b1-open-cloze-oc-025","status":"published","autoGradable":true,"level":"B1","type":"open_cloze","category":"use-of-english","topic":"b1-open-cloze","subtopic":"b1-open-cloze","taxonomyNodeIds":["b1-open-cloze"],"difficulty":5,"instructions":"Complete the sentence with one word.","prompt":"The instructions say that no food is allowed ___ the laboratory.","lessonIds":["b1-use-of-english-open-cloze"],"tags":["b1","open-cloze","prepositions"],"estimatedSeconds":55,"evaluator":{"strategy":"exact_text","answer":"inside","normalization":{"trim":true,"collapseWhitespace":true,"caseSensitive":false,"ignoreTerminalPunctuation":true,"normaliseApostrophes":true}},"explanation":"«Inside the laboratory» clearly marks the place where food is prohibited."}
