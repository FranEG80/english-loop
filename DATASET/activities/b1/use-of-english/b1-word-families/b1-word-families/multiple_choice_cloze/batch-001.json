    {"schemaVersion":"1.0.0","id":"b1-word-families-mcc-004","status":"published","autoGradable":true,"level":"B1","type":"multiple_choice_cloze","category":"use-of-english","topic":"b1-word-families","subtopic":"b1-word-families","taxonomyNodeIds":["b1-word-families"],"difficulty":1,"instructions":"Choose the correct word form.","prompt":"The journey was surprisingly ___. (COMFORT)","options":[{"id":"a","text":"comfort"},{"id":"b","text":"comfortable"},{"id":"c","text":"comfortably"},{"id":"d","text":"comfortingness"}],"lessonIds":["b1-word-families"],"tags":["b1","word-formation","adjectives"],"estimatedSeconds":35,"evaluator":{"strategy":"single_option","correctOptionId":"b"},"explanation":"The adjective «comfortable» follows the adverb «surprisingly»."},
