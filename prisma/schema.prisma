// EnglishLoop - Prisma schema
// SQLite para desarrollo; PostgreSQL como destino futuro.
// Los IDs son UUID generados por la aplicación (no autoincrementales).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Better Auth (tablas requeridas)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  settings     UserSettings?
  savedLessons SavedLesson[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(uuid())
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Account
// ---------------------------------------------------------------------------

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  locale             String   @default("es")
  activeLevels       String   @default("B1") // JSON array
  dailyGoalLessons   Int      @default(1)
  dailyGoalActivities Int     @default(10)
  timezone           String   @default("UTC")
  reducedMotion      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedLesson {
  id       String   @id @default(uuid())
  userId   String
  lessonId String
  savedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Learning: Daily Session
// ---------------------------------------------------------------------------

model DailySession {
  id            String   @id @default(uuid())
  userId        String
  date          String // fecha local del usuario (YYYY-MM-DD)
  status        String   @default("not_started")
  datasetVersion String
  seed          String
  practiceRunId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessons DailySessionLesson[]
  practiceRun PracticeRun? @relation(fields: [practiceRunId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

model DailySessionLesson {
  id            String   @id @default(uuid())
  dailySessionId String
  lessonId      String
  order         Int
  status        String   @default("pending") // pending | completed | skipped
  selectionReason String
  completedAt   DateTime?

  dailySession DailySession @relation(fields: [dailySessionId], references: [id], onDelete: Cascade)

  @@index([dailySessionId])
}

// ---------------------------------------------------------------------------
// Practice
// ---------------------------------------------------------------------------

model PracticeRun {
  id            String   @id @default(uuid())
  userId        String
  mode          String // DAILY | SMART_REVIEW | FOCUSED
  status        String   @default("in_progress") // in_progress | completed
  scopeSnapshot String // JSON: alcance de taxonomía y descendientes
  currentIndex  Int      @default(0)
  originalActivityCount Int @default(0)
  datasetVersion String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailySession DailySession?
  attempts     ActivityAttempt[]
  items        PracticeRunItem[]

  @@index([userId, mode])
}

// ---------------------------------------------------------------------------
// Attempts (inmutables)
// ---------------------------------------------------------------------------

model ActivityAttempt {
  id             String   @id @default(uuid())
  userId         String
  practiceRunId  String?
  activityId     String
  activityVersionId String?
  practiceRunItemId String?
  origin         String // DAILY | SMART_REVIEW | FOCUSED
  idempotencyKey String
  response       String // JSON
  isCorrect      Boolean
  isRepetition   Boolean  @default(false)
  evaluatorVersion String
  submittedAt    DateTime @default(now())

  practiceRun PracticeRun? @relation(fields: [practiceRunId], references: [id])
  activityVersion ActivityVersion? @relation(fields: [activityVersionId], references: [id])
  practiceRunItem PracticeRunItem? @relation(fields: [practiceRunItemId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, activityId])
  @@index([userId, submittedAt])
  @@index([activityVersionId])
  @@index([practiceRunItemId])
}

// ---------------------------------------------------------------------------
// Progress (proyecciones derivadas de intentos)
// ---------------------------------------------------------------------------

model UserActivityProgress {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  attemptsCount Int    @default(0)
  correctCount  Int    @default(0)
  lastResult    Boolean?
  lastAttemptAt DateTime?
  updatedAt     DateTime @updatedAt

  @@unique([userId, activityId])
  @@index([userId])
}

model UserLessonProgress {
  id         String   @id @default(uuid())
  userId     String
  lessonId   String
  viewed     Boolean  @default(false)
  viewedAt   DateTime?
  errorsPending Int   @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model TaxonomyProgress {
  id         String   @id @default(uuid())
  userId     String
  taxonomyNodeId String
  attemptsCount Int    @default(0)
  correctCount  Int    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, taxonomyNodeId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Review
// ---------------------------------------------------------------------------

model ReviewItem {
  id            String   @id @default(uuid())
  userId        String
  activityId    String
  activityVersionId String?
  lessonId      String?
  taxonomyNodeId String
  level         String
  stage         Int      @default(0) // 0=fallo, 1=1er acierto, 2=2º acierto, 3=resuelto
  consecutiveCorrect Int @default(0)
  dueAt         DateTime
  failedAt      DateTime
  resolvedAt    DateTime?
  attemptsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, dueAt])
  @@index([userId, resolvedAt])
}

// ---------------------------------------------------------------------------
// Dataset import
// ---------------------------------------------------------------------------

model DatasetImport {
  id            String   @id @default(uuid())
  datasetVersion String
  checksum      String
  status        String // started | completed | failed
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  result        String? // JSON resumen
  error         String?
  releaseId     String?

  release CatalogRelease? @relation(fields: [releaseId], references: [id])

  @@index([datasetVersion])
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Published catalog
// ---------------------------------------------------------------------------

/// Stable identity of an editorial release. Only the publication pointer is
/// mutable; version rows are immutable after publication.
model CatalogRelease {
  id            String   @id @default(uuid())
  datasetVersion String
  checksum      String
  status        String   // preparing | published | failed
  createdAt     DateTime @default(now())
  publishedAt   DateTime?

  publication       CatalogPublication?
  datasetImports    DatasetImport[]
  taxonomyVersions  TaxonomyNodeVersion[]
  lessonVersions    LessonVersion[]
  activityVersions  ActivityVersion[]

  @@unique([datasetVersion, checksum])
  @@index([status, publishedAt])
}

/// Singleton pointer (`id = active`) to the release visible to readers.
model CatalogPublication {
  id          String   @id
  releaseId   String   @unique
  publishedAt DateTime @default(now())

  release CatalogRelease @relation(fields: [releaseId], references: [id])
}

model ActivityType {
  code     String @id
  versions ActivityVersion[]
}

model EvaluatorStrategy {
  code     String @id
  versions ActivityVersion[]
}

model CefrLevel {
  code           String @id
  lessonVersions LessonVersion[]
  activityVersions ActivityVersion[]
}

model EditorialStatus {
  code           String @id
  lessonVersions LessonVersion[]
  activityVersions ActivityVersion[]
}

model TaxonomyNode {
  id                    String @id
  versions              TaxonomyNodeVersion[]
  lessonVersionLinks    LessonVersionTaxonomy[]
  activityVersionLinks  ActivityVersionTaxonomy[]
}

model TaxonomyNodeVersion {
  id                    String   @id @default(uuid())
  releaseId             String
  nodeId                String
  checksum              String
  parentId              String?
  kind                  String
  labelsEn              String
  labelsEs              String
  levels                String   // JSON array kept as a compact read model
  selectableForPractice Boolean
  sortOrder             Int

  release CatalogRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  node    TaxonomyNode   @relation(fields: [nodeId], references: [id])

  @@unique([releaseId, nodeId])
  @@index([releaseId, parentId, sortOrder])
}

model Lesson {
  id       String  @id
  isDemo   Boolean @default(false)
  versions LessonVersion[]
  activityLinks ActivityVersionLesson[]
}

model LessonVersion {
  id              String   @id @default(uuid())
  releaseId       String
  lessonId        String
  checksum        String
  levelCode       String
  category        String
  taxonomyNodeId  String
  prerequisites   String   @default("[]") // JSON array of prerequisite lesson IDs
  title           String
  summary         String
  explanation     String
  examples        String   // JSON array
  commonMistakes  String   // JSON array
  tags            String   // JSON array
  difficulty      Int
  contentVersion  Int
  statusCode      String

  release CatalogRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id])
  level   CefrLevel      @relation(fields: [levelCode], references: [code])
  status  EditorialStatus @relation(fields: [statusCode], references: [code])
  taxonomyLinks LessonVersionTaxonomy[]

  @@unique([releaseId, lessonId])
  @@index([releaseId, statusCode, levelCode])
}

model LessonVersionTaxonomy {
  id              String @id @default(uuid())
  lessonVersionId String
  taxonomyNodeId  String

  lessonVersion LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  taxonomyNode  TaxonomyNode  @relation(fields: [taxonomyNodeId], references: [id])

  @@unique([lessonVersionId, taxonomyNodeId])
  @@index([taxonomyNodeId])
}

model Activity {
  id       String  @id
  isDemo   Boolean @default(false)
  versions ActivityVersion[]
}

model ActivityVersion {
  id                    String   @id @default(uuid())
  releaseId             String
  activityId            String
  checksum              String
  activityTypeCode      String
  evaluatorStrategyCode String
  levelCode             String
  category              String
  topic                 String
  subtopic              String
  difficulty            Int
  instructions          String
  prompt                String
  passage               String?
  explanation           String
  tags                  String   // JSON array
  lessonIds             String   // JSON compatibility snapshot
  estimatedSeconds      Int
  evaluatorData         String   // JSON for evaluator-specific opaque data
  statusCode             String

  release         CatalogRelease     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  activity        Activity           @relation(fields: [activityId], references: [id])
  activityType    ActivityType      @relation(fields: [activityTypeCode], references: [code])
  evaluatorStrategy EvaluatorStrategy @relation(fields: [evaluatorStrategyCode], references: [code])
  level           CefrLevel          @relation(fields: [levelCode], references: [code])
  status          EditorialStatus    @relation(fields: [statusCode], references: [code])
  lessonLinks     ActivityVersionLesson[]
  taxonomyLinks   ActivityVersionTaxonomy[]
  options         ActivityVersionOption[]
  tokens          ActivityVersionToken[]
  pairs           ActivityVersionPair[]
  expectedAnswers ActivityExpectedAnswer[]
  practiceRunItems PracticeRunItem[]
  attempts        ActivityAttempt[]

  @@unique([releaseId, activityId])
  @@index([releaseId, statusCode, levelCode])
  @@index([activityId])
}

model ActivityVersionLesson {
  id              String @id @default(uuid())
  activityVersionId String
  lessonId        String
  position        Int    @default(0)

  activityVersion ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  lesson          Lesson          @relation(fields: [lessonId], references: [id])

  @@unique([activityVersionId, lessonId])
  @@index([lessonId])
}

model ActivityVersionTaxonomy {
  id              String @id @default(uuid())
  activityVersionId String
  taxonomyNodeId  String
  position        Int    @default(0)

  activityVersion ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  taxonomyNode    TaxonomyNode    @relation(fields: [taxonomyNodeId], references: [id])

  @@unique([activityVersionId, taxonomyNodeId])
  @@index([taxonomyNodeId])
}

model ActivityVersionOption {
  id              String @id @default(uuid())
  activityVersionId String
  optionId        String
  label           String
  feedback        String?
  position        Int

  activityVersion ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  @@unique([activityVersionId, optionId])
}

model ActivityVersionToken {
  id              String @id @default(uuid())
  activityVersionId String
  tokenId         String
  label           String
  feedback        String?
  position        Int

  activityVersion ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  @@unique([activityVersionId, tokenId])
}

model ActivityVersionPair {
  id              String @id @default(uuid())
  activityVersionId String
  leftId          String
  leftLabel       String
  rightId         String
  rightLabel      String
  position        Int

  activityVersion ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  @@index([activityVersionId, position])
}

model ActivityExpectedAnswer {
  id              String @id @default(uuid())
  activityVersionId String
  gapId           String?
  answer          String
  position        Int

  activityVersion ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  @@index([activityVersionId, gapId, position])
}

model PracticeRunItem {
  id                String   @id @default(uuid())
  practiceRunId     String
  position          Int
  lessonId          String?
  activityId        String
  activityVersionId String?
  activitySnapshot   String?
  origin            String
  status            String   @default("pending") // pending | active | answered | repetition
  isRepetition      Boolean  @default(false)
  repetitionOfItemId String?
  answeredAt        DateTime?

  practiceRun   PracticeRun      @relation(fields: [practiceRunId], references: [id], onDelete: Cascade)
  activityVersion ActivityVersion? @relation(fields: [activityVersionId], references: [id])
  repetitionOfItem PracticeRunItem? @relation("PracticeRunItemRepetitions", fields: [repetitionOfItemId], references: [id])
  repetitions   PracticeRunItem[] @relation("PracticeRunItemRepetitions")
  attempts      ActivityAttempt[]

  @@unique([practiceRunId, position])
  @@index([practiceRunId, status])
  @@index([activityId])
}
